#!/usr/bin/env bash
set -euo pipefail
KOF_MUT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$KOF_MUT_ROOT"
IFS= read -r KOF_MUT_CHECK_ID < /proc/sys/kernel/random/uuid
KOF_MUT_CHECK_OBSERVATIONS="$KOF_MUT_ROOT/.agent/tmp/check-$KOF_MUT_CHECK_ID"
mkdir -p -- "$KOF_MUT_CHECK_OBSERVATIONS"
trap 'echo "check observations: $KOF_MUT_CHECK_OBSERVATIONS"' EXIT
KOF_MUT_STAGE_PID=""
signal_running_stage_or_exit() {
    if [[ -n "$KOF_MUT_STAGE_PID" ]]; then kill -"$1" -- "$KOF_MUT_STAGE_PID" 2>/dev/null || true; else exit "$2"; fi
}
trap 'signal_running_stage_or_exit INT 130' INT
trap 'signal_running_stage_or_exit TERM 143' TERM
observed_stage() {
    ( trap - INT; exec ./scripts/observe "$KOF_MUT_CHECK_OBSERVATIONS" "$@" ) &
    KOF_MUT_STAGE_PID=$!
    local status=""
    while [[ -z "$status" ]]; do
        wait "$KOF_MUT_STAGE_PID" && status=0 || status=$?
        if kill -0 "$KOF_MUT_STAGE_PID" 2>/dev/null; then status=""; fi
    done
    KOF_MUT_STAGE_PID=""
    return "$status"
}
observed_stage version -- ./bin/kof-mut --version
observed_stage cli -- kof test src/test/kof/kofmut/Cli.kf
observed_stage run -- kof test src/test/kof/kofmut/Run.kf
observed_stage install -- kof test src/test/kof/kofmut/Install.kf
observed_stage contracts -- ./scripts/launch contracts
