#!/usr/bin/env bash
set -Eeuo pipefail
fail() { echo "kof-mut: launch supervision failed" >&2; exit 2; }
trap fail ERR
KOF_MUT_CHILD=""
KOF_MUT_GROUP=""
KOF_MUT_CREATING=0
KOF_MUT_SIGNAL=""
KOF_MUT_STATUS=2
KOF_MUT_BARRIER=""
signal_child_before_and_after_setsid() {
    if [[ -n "$KOF_MUT_GROUP" ]]; then kill -"$1" -- "-$KOF_MUT_GROUP" 2>/dev/null || true; fi
    kill -"$1" -- "-$KOF_MUT_CHILD" 2>/dev/null || true
    kill -"$1" -- "$KOF_MUT_CHILD" 2>/dev/null || true
}
await_jvm_shutdown_hook_for_detached_commands() {
    local cleanup_start
    cleanup_start="$(date +%s%3N)"
    while (( $(date +%s%3N) - cleanup_start < 2000 )); do
        if { [[ -n "$KOF_MUT_GROUP" ]] && kill -0 -- "-$KOF_MUT_GROUP" 2>/dev/null; } || kill -0 "$KOF_MUT_CHILD" 2>/dev/null; then /bin/sleep 0.02; else break; fi
    done
}
cleanup() {
    if [[ -n "$KOF_MUT_CHILD" ]]; then
        signal_child_before_and_after_setsid TERM
        await_jvm_shutdown_hook_for_detached_commands
        signal_child_before_and_after_setsid KILL
        wait "$KOF_MUT_CHILD" 2>/dev/null || true
    fi
    if [[ -n "$KOF_MUT_BARRIER" ]]; then rm -rf -- "$KOF_MUT_BARRIER"; fi
}
interrupted() {
    if [[ -z "$KOF_MUT_SIGNAL" ]]; then KOF_MUT_SIGNAL=$1; KOF_MUT_STATUS=$2; fi
    if (( KOF_MUT_CREATING )); then return; fi
    trap '' INT TERM
    exit "$KOF_MUT_STATUS"
}
trap cleanup EXIT
trap 'interrupted INT 130' INT
trap 'interrupted TERM 143' TERM
KOF_MUT_BARRIER="$(mktemp -d)" || { echo "kof-mut: cannot create launch handoff" >&2; exit 2; }
mkfifo -- "$KOF_MUT_BARRIER/ready" "$KOF_MUT_BARRIER/release"
exec 8<>"$KOF_MUT_BARRIER/ready" 9<>"$KOF_MUT_BARRIER/release"
KOF_MUT_CREATING=1
setsid bash -c '
    printf "%s\n" "$BASHPID" >&8
    IFS= read -r -u9 release
    [[ "$release" == go ]] || exit 2
    exec 8>&- 9>&-
    exec "$@"
' bash "$@" &
KOF_MUT_CHILD=$!
KOF_MUT_CREATING=0
if [[ -n "$KOF_MUT_SIGNAL" ]]; then interrupted "$KOF_MUT_SIGNAL" "$KOF_MUT_STATUS"; fi
while ! IFS= read -r -t 0.1 -u8 KOF_MUT_READY_GROUP; do
    kill -0 "$KOF_MUT_CHILD" 2>/dev/null || fail
done
[[ "$KOF_MUT_READY_GROUP" =~ ^[0-9]+$ ]] || fail
KOF_MUT_GROUP=$KOF_MUT_READY_GROUP
[[ "$KOF_MUT_GROUP" == "$KOF_MUT_CHILD" ]] || fail
printf 'go\n' >&9
exec 8>&- 9>&-
if wait "$KOF_MUT_CHILD"; then KOF_MUT_RESULT=0; else KOF_MUT_RESULT=$?; fi
cleanup
KOF_MUT_CHILD=""
KOF_MUT_GROUP=""
exit "$KOF_MUT_RESULT"
