#!/usr/bin/env bash
set -Eeuo pipefail
KOF_MUT_RELEASE="$(readlink -f -- "${BASH_SOURCE[0]}")"
KOF_MUT_RELEASE="${KOF_MUT_RELEASE%/*}"
KOF_MUT_PREFIX="$(dirname -- "$(dirname -- "$(dirname -- "$(dirname -- "$KOF_MUT_RELEASE")")")")"
KOF_MUT_USAGE="$KOF_MUT_PREFIX/state/kof-mut/usage.lock"
[[ -f "$KOF_MUT_USAGE" && ! -L "$KOF_MUT_USAGE" ]] || { echo 'kof-mut: missing or invalid installation coordination file: usage.lock' >&2; exit 2; }
# This descriptor keeps the invocation protected across both JVMs and their handoff.
exec 7<"$KOF_MUT_USAGE"
if [[ "${1:-}" == uninstall ]]; then
    flock --nonblock --exclusive 7 || { echo 'kof-mut: installed execution is active; no files removed' >&2; exit 2; }
else
    flock --nonblock --shared 7 || { echo 'kof-mut: installation management is active; try again later' >&2; exit 2; }
fi
exec "$KOF_MUT_RELEASE/scripts/supervise" "$KOF_MUT_RELEASE/scripts/launch" app "$@"
