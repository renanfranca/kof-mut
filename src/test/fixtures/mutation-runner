#!/usr/bin/env bash
set -euo pipefail
phase="$1"
mode="${2:-real}"
if [[ -n "${KOF_MUT_OBSERVATIONS:-}" ]]; then
    if [[ "$phase" == check ]]; then
        printf '%s\0' "$@" > "$KOF_MUT_OBSERVATIONS/argv"
        if IFS= read -r ignored; then printf 'open\n' > "$KOF_MUT_OBSERVATIONS/stdin"; else printf 'closed\n' > "$KOF_MUT_OBSERVATIONS/stdin"; fi
        printf '%s\n' "$PWD" > "$KOF_MUT_OBSERVATIONS/cwd"
        index=0
        while [[ -e "$KOF_MUT_OBSERVATIONS/$index.source" ]]; do ((index+=1)); done
        cp src/math/Calc.kf "$KOF_MUT_OBSERVATIONS/$index.source"
        if [[ -e src/math/data.bin ]]; then cp src/math/data.bin "$KOF_MUT_OBSERVATIONS/$index.binary"; fi
        if [[ -e src/math/alias.txt ]]; then
            cp src/math/alias.txt "$KOF_MUT_OBSERVATIONS/$index.alias"
            if [[ -L src/math/alias.txt ]]; then printf 'link\n' > "$KOF_MUT_OBSERVATIONS/$index.kind"; else printf 'file\n' > "$KOF_MUT_OBSERVATIONS/$index.kind"; fi
        fi
        if [[ -e state ]]; then printf 'dirty\n' > "$KOF_MUT_OBSERVATIONS/$index.state"; else printf 'clean\n' > "$KOF_MUT_OBSERVATIONS/$index.state"; fi
        if [[ -e src/math/New.kf ]]; then cp src/math/New.kf "$KOF_MUT_OBSERVATIONS/$index.new"; fi
    else
        printf 'written by test command\n' > state
    fi
fi
if [[ "$mode" == no-reports ]]; then
    if [[ -e .kof-mut/reports || -e artifacts ]]; then
        printf 'report namespace leaked into sandbox\n' >&2
        exit 127
    fi
fi
mutant=false
if [[ -e src/math/original.txt ]] && ! cmp -s src/math/Calc.kf src/math/original.txt; then mutant=true; fi
if [[ "$mode:$phase" == counter:check ]] && [[ "${5}" == baseline || "$mutant" == true ]]; then
    files=1
    errors=0
    if [[ "${3}" == filesChecked ]]; then files="${4}"; else errors="${4}"; fi
    if [[ "${6:-pass}" == reject ]]; then
        printf '{"success":false,"filesChecked":%s,"errorCount":%s,"diagnostics":[{"code":"SYNTHETIC","severity":"ERROR","message":"synthetic rejection"}]}\n' "$files" "$errors"
        exit 1
    fi
    printf '{"success":true,"filesChecked":%s,"errorCount":%s,"diagnostics":[]}\n' "$files" "$errors"
    exit 0
fi
if [[ "$mode:$phase" == multiple:test ]]; then
    scenario="${3}"
    stage="${4:-mutant}"
    active=false
    if [[ "$stage" == baseline || "$mutant" == true ]]; then active=true; fi
    suite() {
        local name="$1" size="$2" failures="$3"
        printf 'SUITE tests/%s.kf (%s tests)\n' "$name" "$size"
        for ((case_index=failures; case_index<size; case_index++)); do printf 'PASS %s case %s\n' "$name" "$case_index"; done
        for ((case_index=0; case_index<failures; case_index++)); do printf 'FAIL %s case %s: assertion failed\n' "$name" "$case_index"; done
        printf '%s failed of %s tests\n' "$failures" "$size"
        if (( failures )); then printf 'exit code: 1\n'; fi
    }
    first=0
    last=0
    if [[ "$active" == true ]]; then
        if [[ "$scenario" == first || "$scenario" == one-first ]]; then first=1; fi
        if [[ "$scenario" == last ]]; then last=1; fi
    fi
    suite First 2 "$first"
    if [[ "$scenario" != one-invocation && "$scenario" != one-first ]]; then printf '%s passed, %s failed\n' "$((1-first))" "$first"; fi
    if [[ "$active" == true ]]; then
        case "$scenario" in
            duplicate) printf '1 passed, 0 failed\n'; exit 0 ;;
            interrupted) printf 'SUITE tests/Second.kf (1 tests)\nPASS third\n'; exit 0 ;;
            no-suites) printf '0 passed, 0 failed\n'; exit 0 ;;
            skip-only) printf 'SUITE tests/Second.kf (1 tests)\nSKIP third\n0 failed of 1 tests\n1 passed, 0 failed\n'; exit 0 ;;
            orphan-total) printf '0 failed of 2 tests\n1 passed, 0 failed\n'; exit 0 ;;
            wrong-case-total) printf 'SUITE tests/Second.kf (1 tests)\nPASS third\n0 failed of 2 tests\n1 passed, 0 failed\n'; exit 0 ;;
            missing-suite-total) printf 'SUITE tests/Second.kf (1 tests)\nPASS third\n1 passed, 0 failed\n'; exit 0 ;;
        esac
    fi
    if [[ "$scenario" == filtered-skip ]]; then
        printf 'SUITE tests/Second.kf (3 tests)\nkof test: tag selected (2 of 3)\nPASS third\nSKIP ignored\n0 failed of 2 tests\n'
    else
        if [[ "$active:$scenario" == true:exit-zero ]]; then last=1; fi
        suite Second 1 "$last"
    fi
    if [[ "$active" == true ]]; then
        case "$scenario" in
            missing-final) exit 0 ;;
            wrong-files) printf '2 passed, 0 failed\n'; exit 0 ;;
            wrong-failures) printf '0 passed, 1 failed\n'; exit 1 ;;
            exit-one) printf '1 passed, 0 failed\n'; exit 1 ;;
            exit-zero) printf '0 passed, 1 failed\n'; exit 0 ;;
            exit-other) printf '1 passed, 0 failed\n'; exit 127 ;;
            bad-suite-exit) printf 'exit code: 1\n1 passed, 0 failed\n'; exit 0 ;;
        esac
    fi
    if [[ "$scenario" == one-invocation || "$scenario" == one-first ]]; then printf '%s passed, %s failed\n' "$((2-first))" "$first"; else printf '%s passed, %s failed\n' "$((1-last))" "$last"; fi
    if (( first || last )); then exit 1; fi
    exit 0
fi
if [[ "$mutant" == true ]]; then
    if [[ "$mode:$phase" == timeout:test ]]; then
        : "${KOF_MUT_OBSERVATIONS:?}"
        (trap '' TERM; printf '%s\n' "$BASHPID" > "$KOF_MUT_OBSERVATIONS/child.pid"; exec sleep 120) &
        descendant=$!
        printf '%s\n' "$BASHPID" > "$KOF_MUT_OBSERVATIONS/parent.pid"
        while [[ ! -s "$KOF_MUT_OBSERVATIONS/child.pid" ]]; do sleep 0.01; done
        kill -0 "$descendant"
        printf 'ready\n' > "$KOF_MUT_OBSERVATIONS/ready"
        wait "$descendant"
        exit 0
    fi
    case "$mode:$phase" in
        bad-json:check) printf 'not JSON\n'; exit 1 ;;
        false-exit:check) printf '{"success":true,"filesChecked":1,"errorCount":0,"diagnostics":[]}\n'; exit 1 ;;
        false-rejection:check) printf '{"success":false,"filesChecked":1,"errorCount":1,"diagnostics":[]}\n'; exit 1 ;;
        broken-check:check) printf 'check runner unavailable\n' >&2; exit 127 ;;
        coerced-json:check) printf '{"success":"true","filesChecked":1.5,"errorCount":0,"diagnostics":[]}\n'; exit 0 ;;
        missing-summary:test) printf 'SUITE tests/Suite.kf (1 tests)\nFAIL contract: failed\n0 passed, 1 failed\n'; exit 1 ;;
        truncated:test) printf 'SUITE tests/Suite.kf (1 tests)\nFAIL contract: failed\n1 failed of 1 tests\n'; exit 1 ;;
        skipped:test) printf 'SUITE tests/Suite.kf (1 tests)\nSKIP contract: setup failed\n0 failed of 1 tests\n1 passed, 0 failed\n'; exit 0 ;;
        zero:test) printf '0 passed, 0 failed\n'; exit 0 ;;
        contradiction:test) printf 'SUITE tests/Suite.kf (1 tests)\nPASS contract\n0 failed of 1 tests\n1 passed, 0 failed\n'; exit 1 ;;
        header-mismatch:test) printf 'SUITE tests/Suite.kf (2 tests)\nFAIL contract: failed\n1 failed of 1 tests\n0 passed, 1 failed\n'; exit 1 ;;
        runner-error:test) printf 'runner unavailable\n' >&2; exit 127 ;;
    esac
fi
if [[ "$mode" == broken-link ]]; then ln -sf absent generated-link; fi
if [[ "$phase" == check ]]; then exec kof check src/math/Calc.kf --json; fi
exec kof test tests
