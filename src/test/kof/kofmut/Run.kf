test "UTF16 locations and token replacements preserve all other source and binary input bytes", "locations" {
    var root = runProjectCopy()
    var log = root + "/observed"
    Directory(log).createDirectories()
    var copied = process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner")
    assert(copied.exitCode == 0)
    var source = "package src.math\r\nclass Calc {\r\n    Int sum(Int a, Int b) { var note = \"😀 + <= true\" return a + b }\r\n}\r\n"
    var replacement = "package src.math\r\nclass Calc {\r\n    Int sum(Int a, Int b) { var note = \"😀 + <= true\" return a - b }\r\n}\r\n"
    assert(File(root + "/src/math/Calc.kf").writeText(source))
    assert(File(root + "/src/math/Unused.kf").writeText("package src.math\nclass Unused { Int value() { return 0 } }"))
    assert(File(root + "/scope.json").writeText("[\"src/math/Unused.kf\",\"src/math/./Calc.kf\",\"src/math/Calc.kf\"]"))
    var binary = new Int[4]
    binary[0] = 0
    binary[1] = 255
    binary[2] = 13
    binary[3] = 10
    assert(File(root + "/src/math/data.bin").writeBytes(binary))
    assert(File(root + "/expected-variant").writeText(replacement))
    fixtureConfig(root, listOf("./runner", "check"), listOf("./runner", "test"), 10000, 90000)

    try {
        var result = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")
        assert(result.exitCode == 0)
        var report = readRun(reportPath(result.stdout))
        assert(report.scope.size == 2)
        assert(report.scope.get(0) == "src/math/Calc.kf")
        assert(report.scope.get(1) == "src/math/Unused.kf")
        assert(report.counts.candidates == 1)
        assert(report.mutants.get(0).location.offset == 95)
        assert(report.mutants.get(0).location.line == 3)
        assert(report.mutants.get(0).location.column == 64)
        assert(report.mutants.get(0).location.length == 1)
        var originalBytes = process.run("cmp", root + "/src/math/Calc.kf", log + "/0.source")
        var variantBytes = process.run("cmp", root + "/expected-variant", log + "/1.source")
        assert(originalBytes.exitCode == 0)
        assert(variantBytes.exitCode == 0)
        for (var i = 0; i < 2; i++) {
            var binaryBytes = process.run("cmp", root + "/src/math/data.bin", log + "/" + i + ".binary")
            assert(binaryBytes.exitCode == 0)
        }
        assert(readFixtureSource(root) == source)
    } finally { assert(Directory(root).delete()) }
}


test "invalid configuration refuses every internal report before touching bytes or directories", "preservation" {
    var root = runProjectCopy()
    var log = root + "/observed"
    assert(Directory(log).createDirectories())
    assert(process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner").exitCode == 0)
    fixtureConfig(root, listOf("./runner", "check"), listOf("./runner", "test"), 10000, 90000)
    var bytes = new Int[4]
    bytes[0] = 0; bytes[1] = 255; bytes[2] = 13; bytes[3] = 10
    assert(File(root + "/src/math/data.bin").writeBytes(bytes))
    assert(File(root + "/expected.bin").writeBytes(bytes))
    assert(process.run("chmod", "640", root + "/src/math/data.bin").exitCode == 0)
    var alias = root + "-alias"
    var external = root + "-error.json"
    assert(process.run("ln", "-s", root, alias).exitCode == 0)

    try {
        for (var invalid in listOf("{}", "not json")) {
            assert(File(root + "/kof-mut.json").writeText(invalid))
            for (var target in listOf(root + "/src/math/data.bin", root + "/new/output.json", alias + "/new/output.json", root + "/observed")) {
                var result = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", target)

                assert(result.exitCode == 2)
                assert(process.run("cmp", root + "/src/math/data.bin", root + "/expected.bin").exitCode == 0, "invalid config must preserve binary input")
                assert(process.run("stat", "-c", "%a", root + "/src/math/data.bin").stdout.trim() == "640")
                assert(!File(root + "/new").exists(), "refusal must create no output directories")
                assert(Directory(log).list().size == 0, "no project command may start")
                assert(result.stdout.contains("Report destination"), result.stdout)
            }
            assert(Directory(external).createDirectories())
            assert(File(external + "/previous.json").writeText("stale report"))
            var allowed = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", external, "--run-id", "248a229c-2c75-46d4-a802-ae69ac23376b")
            assert(allowed.exitCode == 2)
            var report = readRun(reportPath(allowed.stdout))
            assert(report.status == "error")
            assert(report.runId == "248a229c-2c75-46d4-a802-ae69ac23376b")
            assert(report.baseline.check.exitCode == null)
            assert(Directory(log).list().size == 0)
        }
        var filesystemRoot = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", "/", "--config", root + "/kof-mut.json", "--files", root + "/scope.json", "--report-dir", root + "/src/math/data.bin")
        assert(filesystemRoot.exitCode == 2)
        assert(process.run("cmp", root + "/src/math/data.bin", root + "/expected.bin").exitCode == 0, "filesystem root project must classify every absolute destination as internal")
        assert(process.run("stat", "-c", "%a", root + "/src/math/data.bin").stdout.trim() == "640")
        assert(filesystemRoot.stdout.contains("Report destination"))
        assert(Directory(log).list().size == 0)
    } finally {
        assert(process.run("rm", alias).exitCode == 0)
        if (File(external).exists()) { assert(Directory(external).delete()) }
        assert(Directory(root).delete())
    }
}


test "numeric this field remains mutable when a String local has the same name", "fields" {
    var root = runProjectCopy()
    var source = "package src.math\nclass Calc { Int value = 0 Int sum(Int a, Int b) { String value = \"local\" return a + b + this.value } }\n"
    assert(File(root + "/src/math/Calc.kf").writeText(source))

    try {
        var result = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")

        assert(result.exitCode == 1, result.stdout + result.stderr)
        var report = readRun(reportPath(result.stdout))
        assert(report.status == "complete")
        assert(report.baseline.status == "passed")
        assert(report.counts.candidates == 2)
        assert(report.counts.killed == 1)
        assert(report.counts.survived == 1)
        assert(report.counts.compileError == 0)
        assert(report.discardedCandidates.size == 0)
        assert(report.mutants.get(0).status == "Killed")
        assert(report.mutants.get(1).status == "Survived")
        assert(readFixtureSource(root) == source)
        var textSource = "package src.math\nclass Calc { String value = \"x\" String parameter(Int value) { return this.value + value } String local() { Int value = 2 return this.value + value } }\n"
        assert(File(root + "/src/math/Calc.kf").writeText(textSource))
        assert(File(root + "/tests/Suite.kf").writeText("import src.math.Calc\ntest \"text fields\" { var c = new Calc() assert(c.parameter(1) == \"x1\") assert(c.local() == \"x2\") }"))
        var textRun = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")
        assert(textRun.exitCode == 3)
        var textReport = readRun(reportPath(textRun.stdout))
        assert(textReport.status == "no_mutants")
        assert(textReport.baseline.status == "passed")
        assert(textReport.counts.candidates == 0)
        assert(textReport.discardedCandidates.size == 0)
        assert(readFixtureSource(root) == textSource)
    } finally { assert(Directory(root).delete()) }
}


record CounterInput(String field, String value, String verdict)

test "check counters are validated before narrowing on baseline and variants", "counters" {
    var root = runProjectCopy()
    assert(process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner").exitCode == 0)
    assert(File(root + "/src/math/original.txt").writeText(readFixtureSource(root)))
    var invalid = listOf(CounterInput("filesChecked", "4294967297", "pass"), CounterInput("filesChecked", "4294967296", "pass"), CounterInput("filesChecked", "-4294967295", "pass"), CounterInput("filesChecked", "0", "pass"), CounterInput("filesChecked", "2147483648", "pass"), CounterInput("filesChecked", "1.5", "pass"), CounterInput("filesChecked", "\"1\"", "pass"), CounterInput("errorCount", "4294967296", "pass"), CounterInput("errorCount", "-4294967296", "pass"), CounterInput("errorCount", "4294967297", "reject"), CounterInput("errorCount", "-4294967295", "reject"), CounterInput("errorCount", "-1", "reject"), CounterInput("errorCount", "0.5", "pass"), CounterInput("errorCount", "null", "pass"))

    try {
        for (var stage in listOf("mutant", "baseline")) {
            for (var value in invalid) {
                fixtureConfig(root, listOf("./runner", "check", "counter", value.field, value.value, stage, value.verdict), listOf("./runner", "test"), 10000, 90000)
                var result = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")

                var report = readRun(reportPath(result.stdout))
                assert(report.counts.killed == 0, stage + ": " + value.field + "=" + value.value)
                assert(report.counts.compileError == 0, stage + ": " + value.field + "=" + value.value)
                assert(report.discardedCandidates.size == 0)
                if (stage == "mutant") {
                    assert(result.exitCode == 3)
                    assert(report.baseline.status == "passed")
                    assert(report.status == "incomplete")
                    assert(report.counts.testError == 1)
                    assert(report.mutants.get(0).status == "TestError")
                    assert(report.mutants.get(0).phase == "check")
                    assert(report.mutants.get(0).evidence.contains("Invalid check"))
                } else {
                    assert(result.exitCode == 2)
                    assert(report.status == "baseline_failed")
                    assert(report.baseline.status != "passed")
                    assert(report.baseline.test.exitCode == null)
                    assert(report.counts.candidates == 0)
                }
            }
        }
        fixtureConfig(root, listOf("./runner", "check", "counter", "filesChecked", "2147483647", "baseline", "pass"), listOf("./runner", "test"), 10000, 90000)
        var boundary = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")
        assert(boundary.exitCode == 0)
        assert(readRun(reportPath(boundary.stdout)).baseline.check.filesChecked == 2147483647)
    } finally { assert(Directory(root).delete()) }
}


record RunDiscard(String id, String file, String operator, String original, String replacement, RunLocation location, String phase, Long durationMs, String evidence)
record DiscardReport(List<RunDiscard> discardedCandidates)
List<RunDiscard> readDiscards(String path) {
    var text = File(path).readText()
    if (text != null) { return json.decode<DiscardReport>(text).discardedCandidates }
    throw "missing report"
}


test "comment collisions are discarded before check and later candidates remain isolated", "discard-parse" {
    var root = runProjectCopy()
    var log = root + "/observed"
    assert(Directory(log).createDirectories())
    assert(process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner").exitCode == 0)
    fixtureConfig(root, listOf("./runner", "check"), listOf("./runner", "test"), 10000, 90000)
    assert(File(root + "/tests/Suite.kf").writeText("import src.math.Calc\ntest \"product plus one\" { assert(new Calc().sum(2, 3) == 7) }"))

    try {
        for (var mode in listOf("parser", "tokens", "lexer")) {
            var source = "package src.math\nclass Calc { Int sum(Int a, Int b) { return a*/* comment */b + 1 } }\n"
            var expected = "package src.math\nclass Calc { Int sum(Int a, Int b) { return a*/* comment */b - 1 } }\n"
            if (mode == "tokens") {
                source = "package src.math\nclass Calc {\n Int sum(Int a, Int b) {\n return a*/* comment */b + 1\n }\n}\n"
                expected = "package src.math\nclass Calc {\n Int sum(Int a, Int b) {\n return a*/* comment */b - 1\n }\n}\n"
            }
            if (mode == "lexer") {
                source = "package src.math\nclass Calc {\n Int sum(Int a, Int b) {\n return a*/* comment\n\"*/b + 1\n }\n}\n"
                expected = "package src.math\nclass Calc {\n Int sum(Int a, Int b) {\n return a*/* comment\n\"*/b - 1\n }\n}\n"
            }
            assert(File(root + "/src/math/Calc.kf").writeText(source))
            var result = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")

            assert(result.exitCode == 0, mode + ": " + result.stdout + result.stderr)
            var report = readRun(reportPath(result.stdout))
            assert(report.status == "complete")
            assert(report.baseline.status == "passed")
            assert(report.counts.candidates == 1)
            assert(report.counts.killed == 1)
            assert(report.counts.compileError == 0)
            assert(report.counts.pending == 0)
            assert(report.mutants.get(0).original == "+")
            assert(report.mutants.get(0).status == "Killed")
            var discarded = readDiscards(reportPath(result.stdout))
            assert(discarded.size == 1)
            var item = discarded.get(0)
            assert(item.file == "src/math/Calc.kf")
            assert(item.operator == "arithmetic")
            assert(item.original == "*")
            assert(item.replacement == "/")
            assert(item.location.length == 1)
            assert(item.phase == "parse")
            assert(item.durationMs >= 0)
            assert(item.id != report.mutants.get(0).id)
            if (mode == "parser") { assert(item.evidence.contains("PARSE")) }
            if (mode == "lexer") { assert(item.evidence.contains("LEX002")) }
            if (mode == "tokens") { assert(item.evidence.contains("Variant changes tokens other than the selected token")) }
            assert(item.evidence.contains("log:"))
            assert(File(log + "/0.source").readText() == source)
            assert(File(log + "/1.source").readText() == expected)
            assert(!File(log + "/2.source").exists(), "discarded parse candidate must start no check")
            assert(report.mutants.get(0).evidence.contains("/1-test.stdout"), "logs must retain the candidate index after a discard")
            assert(readFixtureSource(root) == source)
            assert(Directory(log).delete())
            assert(Directory(log).createDirectories())
        }
    } finally { assert(Directory(root).delete()) }
}


test "compiler rejection permits a later detected mutant with independent check logs", "discard-check" {
    var root = runProjectCopy()
    var log = root + "/observed"
    assert(Directory(log).createDirectories())
    assert(process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner").exitCode == 0)
    var source = "package src.math\nclass Calc { Int sum(Int a, Int b) { return 7 * 0 + 1 } }\n"
    assert(File(root + "/src/math/Calc.kf").writeText(source))
    assert(File(root + "/tests/Suite.kf").writeText("import src.math.Calc\ntest \"one\" { assert(new Calc().sum(2, 3) == 1) }"))
    fixtureConfig(root, listOf("./runner", "check"), listOf("./runner", "test"), 10000, 90000)

    try {
        var result = process.run("env", "KOF_MUT_OBSERVATIONS=" + log, "./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/report.json")

        assert(result.exitCode == 0)
        var report = readRun(reportPath(result.stdout))
        assert(report.status == "complete")
        assert(report.counts.candidates == 1)
        assert(report.counts.executed == 1)
        assert(report.counts.killed == 1)
        assert(report.counts.pending == 0)
        assert(report.discardedCandidates.size == 1)
        var rejected = report.discardedCandidates.get(0)
        assert(rejected.phase == "check")
        assert(rejected.evidence.contains("ARITH001"))
        assert(rejected.evidence.contains("/0-check.stdout"))
        assert(report.mutants.get(0).evidence.contains("/1-test.stdout"))
        assert(rejected.id != report.mutants.get(0).id)
        assert(File(log + "/0.source").readText() == source)
        assert(File(log + "/1.source").readText() == "package src.math\nclass Calc { Int sum(Int a, Int b) { return 7 / 0 + 1 } }\n")
        assert(File(log + "/2.source").readText() == "package src.math\nclass Calc { Int sum(Int a, Int b) { return 7 * 0 - 1 } }\n")
        assert(!File(log + "/3.source").exists())
        assert(readFixtureSource(root) == source)
    } finally { assert(Directory(root).delete()) }
}

String reportPath(String output) {
    var found = ""
    var count = 0
    for (var line in output.split("\n")) {
        if (line.startsWith("reportPath=")) {
            found = json.decode<String>(line.substring(11))
            count++
        }
    }
    assert(count == 1, "one report path announcement required: " + output)
    assert(new java.io.File(found).isAbsolute())
    return found
}

test "each invocation reserves and announces its own report with canonical project identity", "m3" {
    var root = runProjectCopy()
    assert(File(root + "/scope.json").writeText("[]"))
    var alias = root + "-alias"
    assert(process.run("ln", "-s", root, alias).exitCode == 0)
    var custom = root + "/artifacts ação \"😀\"\nline"
    var id = "248a229c-2c75-46d4-a802-ae69ac23376b"
    try {
        var first = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--run-id", id)

        assert(first.exitCode == 3, first.stdout + first.stderr)
        var firstPath = reportPath(first.stdout)
        assert(firstPath.startsWith(root + "/.kof-mut/reports/"))
        var original = reportText(firstPath)
        var firstReport = readRun(firstPath)
        assert(firstReport.status == "no_scope")
        assert(firstReport.runId == id)
        assert(File(root + "/canonical-path").writeText(root))
        var hash = process.run("sha256sum", root + "/canonical-path").stdout.split(" ")[0]
        assert(new java.io.File(firstPath).getParentFile().getParentFile().getName() == hash)
        for (var project in listOf(root, alias)) {
            var next = process.run("./bin/kof-mut", "run", "--project", project, "--files", root + "/scope.json", "--report-dir", custom, "--run-id", id)
            assert(next.exitCode == 3, next.stdout + next.stderr)
            var nextPath = reportPath(next.stdout)
            assert(nextPath.startsWith(custom + "/" + hash + "/" + id + "-"))
            assert(nextPath != firstPath)
            assert(readRun(nextPath).runId == id)
            assert(reportText(firstPath) == original)
            firstPath = nextPath
            original = reportText(firstPath)
        }
        assert(File(root + "/scope.json").writeText("[\"src/math/Calc.kf\"]"))
        assert(File(root + "/kof-mut.json").writeText(json.encode(FixtureConfig(1, listOf("src"), listOf("tests"), listOf("src", "tests", "kof.toml"), listOf("touch", root + "/legacy-command"), listOf("kof", "test", "tests"), 10000, 30000))))
        var legacy = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report", root + "/forbidden")
        assert(legacy.exitCode == 2)
        assert(legacy.stdout.contains("--report-dir"))
        assert(!legacy.stdout.contains("reportPath="))
        assert(!File(root + "/forbidden").exists())
        assert(!File(root + "/legacy-command").exists(), "legacy flag must be rejected before project commands")
    } finally { assert(process.run("rm", alias).exitCode == 0); assert(Directory(root).delete()) }
}

String reportText(String path) {
    var value = File(path).readText()
    if (value != null) { return value }
    throw "Missing file: " + path
}

test "whole project snapshots omit both report namespaces and preserve input inventory", "m3" {
    var root = runProjectCopy()
    assert(process.run("cp", "-a", "src/test/fixtures/mutation-runner", root + "/runner").exitCode == 0)
    assert(Directory(root + "/.kof-mut/reports").createDirectories())
    assert(Directory(root + "/artifacts").createDirectories())
    assert(File(root + "/.kof-mut/reports/old.json").writeText("previous default"))
    assert(File(root + "/artifacts/old.json").writeText("previous custom"))
    assert(File(root + "/kof-mut.json").writeText(json.encode(FixtureConfig(1, listOf("src"), listOf("tests"), listOf("."), listOf("./runner", "check", "no-reports"), listOf("./runner", "test", "no-reports"), 10000, 90000))))
    var before = process.run("find", root + "/src", root + "/tests", "-type", "f", "-exec", "sha256sum", "{}", ";").stdout
    try {
        var result = process.run("./bin/kof-mut", "run", "--project", root, "--files", root + "/scope.json", "--report-dir", root + "/artifacts")

        assert(result.exitCode == 0, result.stdout + result.stderr)
        assert(readRun(reportPath(result.stdout)).counts.killed == 1)
        assert(File(root + "/.kof-mut/reports/old.json").readText() == "previous default")
        assert(File(root + "/artifacts/old.json").readText() == "previous custom")
        assert(process.run("find", root + "/src", root + "/tests", "-type", "f", "-exec", "sha256sum", "{}", ";").stdout == before)
    } finally { assert(Directory(root).delete()) }
}

void waitReady(String path) {
    var start = System.nanoTime()
    while (!File(path).exists() && (System.nanoTime() - start) / 1000000 < 15000) { Thread.sleep(20 as Long) }
    assert(File(path).exists(), "readiness missing: " + path)
}

Process startRun(String root, String log, String reports) {
    assert(Directory(log).createDirectories())
    var argv = new String[12]
    argv[0] = "env"; argv[1] = "KOF_MUT_OBSERVATIONS=" + log
    argv[2] = "./bin/kof-mut"; argv[3] = "run"; argv[4] = "--project"; argv[5] = root
    argv[6] = "--files"; argv[7] = root + "/scope.json"
    argv[8] = "--report-dir"; argv[9] = reports
    argv[10] = "--run-id"; argv[11] = "248a229c-2c75-46d4-a802-ae69ac23376b"
    var builder = new java.lang.ProcessBuilder(argv)
    builder.redirectOutput(new java.io.File(log + "/stdout"))
    builder.redirectError(new java.io.File(log + "/stderr"))
    var child = builder.start()
    child.getOutputStream().close()
    return child
}

void prepareControlled(String root, String mode, Long timeout, Long budget) {
    assert(process.run("cp", "-a", "src/test/fixtures/m3-runner", root + "/runner").exitCode == 0)
    assert(File(root + "/src/math/original.txt").writeText(readFixtureSource(root)))
    fixtureConfig(root, listOf("./runner", "check", mode), listOf("./runner", "test", mode), timeout, budget)
}

void assertStopped(String log) {
    assert(!activePid(reportText(log + "/parent.pid")), "command parent remains active")
    assert(!activePid(reportText(log + "/child.pid")), "command descendant remains active")
    var sandbox = new java.io.File(reportText(log + "/cwd").trim()).getParent()
    assert(!File(sandbox).exists(), "execution sandbox remains")
}

test "INT and TERM clean their execution while a simultaneous run remains active and recoverable", "m3" {
    var root = runProjectCopy()
    prepareControlled(root, "baseline-check", 30000, 60000)
    try {
        for (var signal in listOf("INT", "TERM")) {
            var firstLog = root + "/" + signal + "-first"
            var secondLog = root + "/" + signal + "-second"
            var first = startRun(root, firstLog, root + "/artifacts")
            var second = startRun(root, secondLog, root + "/artifacts")
            try {
                waitReady(firstLog + "/ready"); waitReady(secondLog + "/ready")
                assert(first.isAlive() && second.isAlive(), "both invocations must overlap")
                var firstPath = reportPath(reportText(firstLog + "/stdout"))
                var secondPath = reportPath(reportText(secondLog + "/stdout"))
                assert(firstPath != secondPath, "same project and UUID require different reservations")
                assert(!File(firstPath).exists() && !File(secondPath).exists())

                assert(process.run("kill", "-" + signal, "" + first.pid()).exitCode == 0)
                assert(first.waitFor(5000 as Long, TimeUnit.MILLISECONDS))
                var expected = 130
                if (signal == "TERM") { expected = 143 }
                assert(first.exitValue() == expected)
                assertStopped(firstLog)
                assert(!File(firstPath).exists(), "interrupted execution must not publish complete")
                assert(second.isAlive())
                assert(activePid(reportText(secondLog + "/parent.pid")))
                assert(activePid(reportText(secondLog + "/child.pid")))
                assert(File(secondLog + "/release").writeText("continue"))
                assert(second.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
                assert(second.exitValue() == 0, reportText(secondLog + "/stdout") + reportText(secondLog + "/stderr"))
                assert(readRun(secondPath).status == "complete")
                assertStopped(secondLog)
            } finally {
                first.destroyForcibly(); second.destroyForcibly()
                for (var log in listOf(firstLog, secondLog)) {
                    if (File(log + "/parent.pid").exists()) { var killed = process.run("kill", "-KILL", "--", "-" + reportText(log + "/parent.pid").trim()) }
                }
            }
        }
        prepareControlled(root, "none", 10000, 30000)
        var recovered = startRun(root, root + "/recovered", root + "/artifacts")
        assert(recovered.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
        assert(recovered.exitValue() == 0)
        assert(readRun(reportPath(reportText(root + "/recovered/stdout"))).status == "complete")
    } finally { assert(Directory(root).delete()) }
}

test "a filesystem publication failure preserves earlier reports and the next run recovers", "m3" {
    var root = runProjectCopy()
    prepareControlled(root, "none", 10000, 30000)
    try {
        var first = startRun(root, root + "/first", root + "/artifacts")
        assert(first.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
        assert(first.exitValue() == 0)
        var previous = reportPath(reportText(root + "/first/stdout"))
        var previousBytes = reportText(previous)
        prepareControlled(root, "baseline-check", 10000, 30000)
        var log = root + "/failure"
        var failing = startRun(root, log, root + "/artifacts")
        try {
            waitReady(log + "/ready")
            var announced = reportPath(reportText(log + "/stdout"))
            var reserved = new java.io.File(announced).getParent()
            assert(Directory(reserved).delete(), "reservation could not be removed: " + reserved)
            assert(File(reserved).writeText("filesystem obstruction"))

            assert(File(log + "/release").writeText("continue"))
            assert(failing.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
            assert(failing.exitValue() == 2, "publication exit=" + failing.exitValue() + ": " + reportText(log + "/stdout") + reportText(log + "/stderr"))
            assert(!File(announced).exists(), "a failed publication must expose no final JSON")
            assert(!reportText(log + "/stdout").contains(": complete"))
            assert(reportText(previous) == previousBytes)
            assertStopped(log)
        } finally { failing.destroyForcibly() }
        prepareControlled(root, "none", 10000, 30000)
        var next = startRun(root, root + "/next", root + "/artifacts")
        assert(next.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
        assert(next.exitValue() == 0, reportText(root + "/next/stdout") + reportText(root + "/next/stderr"))
        var nextPath = reportPath(reportText(root + "/next/stdout"))
        assert(nextPath != previous)
        assert(readRun(nextPath).counts.killed == 1)
        assert(reportText(previous) == previousBytes)
    } finally { assert(Directory(root).delete()) }
}


test "the global budget stops baseline check baseline test and variant phases without later commands", "m3" {
    var root = runProjectCopy()
    assert(File(root + "/src/math/Calc.kf").writeText("package src.math\nclass Calc { Int sum(Int a, Int b) { return a + b + 0 } }\n"))
    try {
        for (var mode in listOf("baseline-check", "baseline-test", "variant-check", "variant-test")) {
            prepareControlled(root, mode, 10000, 1500)
            var log = root + "/" + mode
            var child = startRun(root, log, root + "/artifacts")
            try {
                waitReady(log + "/ready")
                assert(child.waitFor(7000 as Long, TimeUnit.MILLISECONDS))
                assert(child.exitValue() == 3, reportText(log + "/stdout") + reportText(log + "/stderr"))
                assertStopped(log)
                var report = readRun(reportPath(reportText(log + "/stdout")))
                assert(report.status == "incomplete")
                assert(report.durationMs >= 1500 && report.durationMs < 5000)
                var commands = reportText(log + "/commands")
                if (mode == "baseline-check") {
                    assert(commands == "baseline:check\n")
                    assert(report.baseline.check.summary != null)
                    assert(report.baseline.test.exitCode == null)
                    assert(report.counts.candidates == 0)
                }
                if (mode == "baseline-test") {
                    assert(commands == "baseline:check\nbaseline:test\n")
                    assert(report.baseline.check.exitCode == 0)
                    assert(report.baseline.test.summary != null)
                    assert(report.counts.candidates == 0)
                }
                if (mode.startsWith("variant")) {
                    var expected = "baseline:check\nbaseline:test\nvariant:check\n"
                    var phase = "check"
                    if (mode == "variant-test") { expected = expected + "variant:test\n"; phase = "test" }
                    assert(commands == expected)
                    assert(report.baseline.status == "passed")
                    assert(report.counts.candidates == 2)
                    assert(report.counts.timeout == 1)
                    assert(report.counts.pending == 1)
                    assert(report.mutants.get(0).phase == phase)
                    assert(report.mutants.get(1).status == "Pending")
                    assert(report.mutants.get(1).durationMs == 0)
                    assert(report.discardedCandidates.size == 0)
                }
            } finally { child.destroyForcibly() }
        }
        prepareControlled(root, "none", 10000, 1)
        var exhausted = startRun(root, root + "/preparation", root + "/artifacts")
        assert(exhausted.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
        assert(exhausted.exitValue() == 3)
        var preparation = readRun(reportPath(reportText(root + "/preparation/stdout")))
        assert(preparation.baseline.check.exitCode == null)
        assert(!File(root + "/preparation/commands").exists(), "preparation consumes the same global budget")
        prepareControlled(root, "none", 10000, 30000)
        var recovered = startRun(root, root + "/recovered", root + "/artifacts")
        assert(recovered.waitFor(10000 as Long, TimeUnit.MILLISECONDS))
        assert(recovered.exitValue() == 0)
        assert(readRun(reportPath(reportText(root + "/recovered/stdout"))).counts.killed == 2)
    } finally { assert(Directory(root).delete()) }
}

test "caller relative paths and projects with the same basename have independent identities", "m3" {
    var root = runProjectCopy()
    var executable = new java.io.File("bin/kof-mut").getCanonicalPath()
    try {
        for (var parent in listOf("one", "two")) {
            assert(Directory(root + "/" + parent + "/same").createDirectories())
            assert(process.run("cp", "-a", "fixtures/detected/.", root + "/" + parent + "/same").exitCode == 0)
            assert(File(root + "/" + parent + "/same/scope.json").writeText("[]"))
        }
        var first = process.run("env", "--chdir=" + root, executable, "run", "--project", "one/same", "--files", "one/same/scope.json", "--config", "kof-mut.json", "--report-dir", "reports")
        var second = process.run("env", "--chdir=" + root, executable, "run", "--project", "two/same", "--files", "two/same/scope.json", "--report-dir", "reports")

        assert(first.exitCode == 3 && second.exitCode == 3)
        var firstPath = reportPath(first.stdout)
        var secondPath = reportPath(second.stdout)
        assert(firstPath.startsWith(root + "/reports/") && secondPath.startsWith(root + "/reports/"))
        assert(new java.io.File(firstPath).getParentFile().getParent() != new java.io.File(secondPath).getParentFile().getParent())
        assert(readRun(firstPath).status == "no_scope")
        assert(readRun(secondPath).status == "no_scope")
    } finally { assert(Directory(root).delete()) }
}

test "clamping negatives has one equivalent boundary survivor across negative zero and positive inputs", "m3" {
    var result = process.run("./bin/kof-mut", "run", "--project", "fixtures/equivalent", "--files", "fixtures/equivalent/scope.json", "--report-dir", ".agent/tmp/m3/equivalent")

    assert(result.exitCode == 1, result.stdout + result.stderr)
    var report = readRun(reportPath(result.stdout))
    assert(report.status == "complete")
    assert(report.baseline.status == "passed")
    assert(report.baseline.test.executedTests == 3)
    assert(report.counts.candidates == 1)
    assert(report.counts.survived == 1)
    assert(report.counts.killed == 0)
    assert(report.discardedCandidates.size == 0)
    assert(report.limitations.size == 0)
    assert(report.mutants.get(0).operator == "boundary")
    assert(report.mutants.get(0).original == "<")
    assert(report.mutants.get(0).replacement == "<=")
    assert(report.mutants.get(0).location.line == 5)
    assert(report.mutants.get(0).location.column == 15)
}
