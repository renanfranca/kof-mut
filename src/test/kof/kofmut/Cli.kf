import java.lang.System
import java.lang.Process
import java.util.concurrent.TimeUnit
import java.lang.Thread
import java.nio.file.Files

record Observation(List<String> arguments, String cwd, String environment)

String disposableProject() {
    Directory(".agent/tmp").createDirectories()
    var temporary = Files.createTempDirectory(new java.io.File(".agent/tmp").toPath(), "launcher-").toString()
    var project = new java.io.File(temporary + "/project with spaces").getCanonicalPath()
    println("disposable project: " + project)
    assert(Directory(project).createDirectories())
    var copied = process.run("/bin/cp", "-a", "bin", "scripts", "src", "VERSION", "kof.toml", project)
    assert(copied.exitCode == 0)
    return project
}

String controlledPath(String project) {
    assert(Directory(project + "/toolchain").createDirectories())
    var copied = process.run("/bin/cp", "-a", "src/test/fixtures/controlled-toolchain/kof", project + "/toolchain/kof")
    assert(copied.exitCode == 0)
    return project + "/toolchain:" + System.getenv("PATH")
}

test "warm public commands run with compilation disabled" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(prepared.exitCode == 0)

        var version = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
        var help = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--help")

        assert(version.exitCode == 0, "warm version must not compile even the bootstrap")
        assert(version.stdout == "KofMut 0.1.0\n")
        assert(help.exitCode == 0)
        assert(help.stdout.contains("Usage: kof-mut"))
        assert(File(log).readText() == "build\n")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "source launcher prints the version from VERSION" {
    var expected = File("VERSION").readText()

    var result = process.run("./bin/kof-mut", "--version")

    if (result.exitCode != 0) {
        println(result.stdout)
        println(result.stderr)
    }
    assert(result.exitCode == 0, "version command must succeed")
    assert(expected != null)
    if (expected != null) {
        assert(result.stdout.trim() == "KofMut " + expected.trim(), "version must come from VERSION")
    }
}

test "an incomplete selected Kof is rejected before using a cached bootstrap" {
    var fake = Path("src/test/fixtures/unsupported-toolchain/bin").toAbsolute().path()
    var inherited = System.getenv("PATH")
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()

    var result = process.run("env", "PATH=" + fake + ":" + inherited, "KOF_MUT_TEST_KOF=" + kof, "./bin/kof-mut", "--version")

    assert(result.exitCode == 2)
    assert(result.stderr.contains("incomplete Kof distribution"))
    assert(!result.stdout.contains("KofMut 0.1.0"))
}

test "source launcher works with no Python executable on PATH" {
    var root = Path(".").toAbsolute().path()
    Directory(root + "/.agent/tmp").createDirectories()
    var temporary = Files.createTempDirectory(new java.io.File(root + "/.agent/tmp").toPath(), "no-python-").toString()
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    for (var tool in listOf("bash", "dirname", "readlink", "sed", "head", "mktemp", "mkfifo", "setsid", "date", "timeout", "cp", "mkdir", "rm", "find", "sort", "sha256sum", "b2sum", "cat", "cmp")) {
        var linked = process.run("/bin/ln", "-s", "/usr/bin/" + tool, temporary + "/" + tool)
        assert(linked.exitCode == 0)
    }
    var linkedKof = process.run("/bin/ln", "-s", kof, temporary + "/kof")
    assert(linkedKof.exitCode == 0)

    try {
        var result = process.run("/usr/bin/env", "PATH=" + temporary, root + "/bin/kof-mut", "--version")

        if (result.exitCode != 0) { println(result.stderr) }
        assert(result.exitCode == 0, "launcher must run without Python on PATH")
        assert(result.stdout.trim() == "KofMut 0.1.0")
    } finally {
        var removed = process.run("/bin/rm", "-rf", temporary)
        assert(removed.exitCode == 0)
    }
}

test "launcher preserves argv cwd environment and application exit status", "launch-arguments" {
    var project = disposableProject()
    var caller = project + "/caller"
    assert(Directory(caller).createDirectories(), "expected: Directory(caller).createDirectories()")
    var copied = process.run("/bin/cp", "src/test/fixtures/LaunchObservation.kf", project + "/src/main/kof/kofmut/Main.kf")
    assert(copied.exitCode == 0, "expected: copied.exitCode == 0")

    var completed = false
    try {
        var result = process.run("/usr/bin/env", "--chdir=" + caller, "KOF_MUT_TEST_VALUE=env 😀 value", project + "/bin/kof-mut", "", "space value", "ação 😀", "line\nbreak", "$(touch INJECTED);*'\"\\", "--target", "not-a-target", "--deps", "missing-dependency")

        if (result.exitCode != 23) { println(result.stderr) }
        assert(result.exitCode == 23, "application exit status must be preserved")
        var observed = json.decode<Observation>(result.stdout)
        assert(observed.arguments.size() == 9, "expected: observed.arguments.size() == 9")
        assert(observed.arguments[0] == "", "expected: observed.arguments[0] == \"\"")
        assert(observed.arguments[1] == "space value", "expected: observed.arguments[1] == \"space value\"")
        assert(observed.arguments[2] == "ação 😀", "expected: observed.arguments[2] == \"ação 😀\"")
        assert(observed.arguments[3] == "line\nbreak", "expected: observed.arguments[3] == \"line\\nbreak\"")
        assert(observed.arguments[4] == "$(touch INJECTED);*'\"\\", "expected: observed.arguments[4] == \"$(touch INJECTED);*'\\\"\\\\\"")
        assert(observed.arguments[5] == "--target", "expected: observed.arguments[5] == \"--target\"")
        assert(observed.arguments[6] == "not-a-target", "expected: observed.arguments[6] == \"not-a-target\"")
        assert(observed.arguments[7] == "--deps", "expected: observed.arguments[7] == \"--deps\"")
        assert(observed.arguments[8] == "missing-dependency", "expected: observed.arguments[8] == \"missing-dependency\"")
        assert(observed.cwd == caller, "expected: observed.cwd == caller")
        assert(observed.environment == "env 😀 value", "expected: observed.environment == \"env 😀 value\"")
        assert(!File(caller + "/INJECTED").exists(), "expected: !File(caller + \"/INJECTED\").exists()")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "failure to prepare the launch handoff returns an explicit error" {
    var missing = Path(".agent/tmp/missing-handoff-" + System.nanoTime()).toAbsolute().path()

    var result = process.run("/usr/bin/env", "TMPDIR=" + missing, "./bin/kof-mut", "--version")

    assert(result.exitCode == 2, "launch preparation failure must return 2")
    assert(result.stdout == "")
    assert(result.stderr.contains("kof-mut: cannot create launch handoff"))
}

test "cache is reused and invalidated by VERSION and source contents" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var first = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        var second = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(first.exitCode == 0, "expected: first.exitCode == 0")
        assert(second.exitCode == 0, "expected: second.exitCode == 0")
        assert(File(log).readText() == "build\n", "unchanged input must reuse the compiled application")

        assert(File(project + "/VERSION").writeText("0.1.0-cache-proof\n"), "expected: File(project + \"/VERSION\").writeText(\"0.1.0-cache-proof\\n\")")
        var version = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(version.exitCode == 0, "expected: version.exitCode == 0")
        assert(version.stdout == "KofMut 0.1.0-cache-proof\n", "expected: version.stdout == \"KofMut 0.1.0-cache-proof\\n\"")
        assert(File(log).readText() == "build\nbuild\n", "VERSION must invalidate the cache")

        var copied = process.run("/bin/cp", "src/test/fixtures/LaunchObservation.kf", project + "/src/main/kof/kofmut/Main.kf")
        assert(copied.exitCode == 0, "expected: copied.exitCode == 0")
        var source = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_VALUE=new source", project + "/bin/kof-mut", "--fixture")
        assert(source.exitCode == 23, "expected: source.exitCode == 23")
        assert(source.stdout.contains("new source"), "expected: source.stdout.contains(\"new source\")")
        assert(File(log).readText() == "build\nbuild\nbuild\n", "changed source bytes must invalidate the cache")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "invalid toolchain JSON cannot launch an existing cached application" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var valid = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(valid.exitCode == 0)

        var invalid = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_INFO=invalid", project + "/bin/kof-mut", "--version")

        assert(invalid.exitCode == 2)
        assert(invalid.stdout == "")
        assert(invalid.stderr.contains("kof-mut:"))
        assert(File(log).readText() == "build\n", "invalid toolchain evidence must stop before building or launching")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "toolchain executable remains fixed if its PATH link changes after discovery" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var original = project + "/toolchain/original-kof"
    var replacement = project + "/toolchain/replacement-kof"
    var link = project + "/toolchain/kof"
    assert(process.run("/bin/mv", link, original).exitCode == 0)
    assert(File(replacement).writeText("#!/bin/sh\necho 'replacement toolchain must not run' >&2\nexit 91\n"))
    assert(process.run("/bin/chmod", "+x", replacement).exitCode == 0)
    assert(process.run("/bin/ln", "-s", original, link).exitCode == 0)

    var completed = false
    try {
        var result = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_LINK=" + link, "KOF_MUT_TEST_REPLACEMENT=" + replacement, project + "/bin/kof-mut", "--version")

        if (result.exitCode != 0) { println(result.stderr) }
        assert(result.exitCode == 0)
        assert(result.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\n")
        assert(new java.io.File(link).getCanonicalPath() == replacement)
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "compiler failure after emitting classes is rejected and retried" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var failed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_BUILD=fail-after-output", project + "/bin/kof-mut", "--version")

        assert(failed.exitCode == 2)
        assert(failed.stdout == "")
        assert(failed.stderr.contains("controlled compilation failure after output"))
        var retry = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(retry.exitCode == 0)
        assert(retry.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\nbuild\n", "failed compilation must not publish a usable cache entry")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "concurrent cold informational launches compile the minimal bootstrap exactly once" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var first = process.spawn("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
    var second = process.spawn("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")

    var completed = false
    try {
        var deadline = System.currentTimeMillis() + 30000
        while ((first.alive() || second.alive()) && System.currentTimeMillis() < deadline) { Thread.sleep(25) }

        assert(!first.alive() && !second.alive(), "concurrent launches must finish")
        assert(first.exitCode() == 0, "expected: first.exitCode() == 0")
        assert(second.exitCode() == 0, "expected: second.exitCode() == 0")
        assert(first.readLine() == "KofMut 0.1.0", "expected: first.readLine() == \"KofMut 0.1.0\"")
        assert(second.readLine() == "KofMut 0.1.0", "expected: second.readLine() == \"KofMut 0.1.0\"")
        assert(File(log).readText() == "build\n", "the second process must recheck the cache after acquiring the lock")
        completed = true
    } finally {
        if (first.alive()) { first.kill() }
        if (second.alive()) { second.kill() }
        cliCleanup(project, completed)
    }
}

test "interrupted compilation cannot publish classes and a fresh launch succeeds" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var ready = project + "/compiler-ready"
    var interrupted = process.spawn("/usr/bin/setsid", "/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_BUILD=interrupt-after-output", "KOF_MUT_TEST_READY=" + ready, project + "/bin/kof-mut", "--version")
    var group = ""

    var completed = false
    try {
        var deadline = System.currentTimeMillis() + 30000
        while (!File(ready).exists() && interrupted.alive() && System.currentTimeMillis() < deadline) { Thread.sleep(25) }
        assert(File(ready).exists(), "controlled compiler must finish emitting classes before interruption")
        var staging = File(ready).readText()
        assert(staging != null)
        if (staging != null) { assert(File(staging.trim() + "/classes/Default/Main.class").isFile()) }
        var compilerPid = File(ready + ".pid").readText()
        assert(compilerPid != null)
        if (compilerPid != null) {
            var pgid = process.run("/bin/ps", "-o", "pgid=", "-p", compilerPid.trim())
            assert(pgid.exitCode == 0)
            group = pgid.stdout.trim()
        }
        assert(group != "")
        assert(process.run("/bin/kill", "-TERM", "--", "-" + group).exitCode == 0)
        deadline = System.currentTimeMillis() + 10000
        while (interrupted.alive() && System.currentTimeMillis() < deadline) { Thread.sleep(25) }
        assert(!interrupted.alive(), "interrupted launcher must terminate")
        assert(interrupted.exitCode() != 0)

        var retry = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(retry.exitCode == 0)
        assert(retry.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\nbuild\n", "interrupted output must not be reused as a complete build")
        completed = true
    } finally {
        if (group != "") { var killed = process.run("/bin/kill", "-KILL", "--", "-" + group) }
        if (interrupted.alive()) { interrupted.kill() }
        cliCleanup(project, completed)
    }
}

test "inconsistent location descriptor is prepared again automatically" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var first = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(first.exitCode == 0)
        var directory = project + "/build/cache/kof-launch-v2/locations"
        var names = Directory(directory).list()
        assert(names.size() == 1)
        var descriptor = File(directory + "/" + names[0]).readText()
        assert(descriptor != null)
        if (descriptor != null) {
            var fields = descriptor.split("\0")
            assert(File(directory + "/" + names[0]).writeText("kofmut-location-v1\0/bin/false\0" + fields[2] + "\0"))
        }

        var recovered = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")

        assert(recovered.exitCode == 0, "a descriptor inconsistent with the validated image must be repaired")
        assert(recovered.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\n", "repairing location metadata must reuse the complete image")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "incomplete or damaged bootstrap images are rebuilt before public commands" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var first = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(first.exitCode == 0)
        var images = project + "/build/cache/kof-launch-v2/images"
        var names = Directory(images).list()
        assert(names.size() == 1)
        var image = images + "/" + names[0]
        var expectedBuilds = "build\n"
        for (var relative in listOf("identity", "classes/Default/Main.class", "classes/kofmut/launch/CompatibilityEntry.class", "classes/dev/kof/runtime/KofRuntime.class")) {
            var component = image + "/" + relative
            var saved = cliSaveOriginal(project, component)
            assert(File(component).writeText("incomplete image\n"), "expected: image component damaged")
            cliVersionRequiresPreparation(project, path, kof, log, expectedBuilds, relative)
            cliRestoreOriginal(saved, component)
            cliVersionReusesImage(project, path, kof, log, relative)
        }
        assert(File(image + "/classes/kofmut/launch/CompatibilityEntry.class").delete())
        var missing = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(missing.exitCode == 0)
        assert(File(log).readText() == expectedBuilds + "build\n")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "tool input bytes invalidate images even when timestamps are preserved" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var first = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(first.exitCode == 0)
        var builds = "build\n"
        for (var relative in listOf("src/main/kof/kofmut/launch/Compatibility.kf", "scripts/supervise", "scripts/bootstrap/Launch.kf", "scripts/launch", "bin/kof-mut", "scripts/check", "VERSION", "kof.toml", "toolchain/kof")) {
            var file = project + "/" + relative
            var saved = cliChangeKeepingTimestamp(project, file, "\n")
            cliVersionRequiresPreparation(project, path, kof, log, builds, relative)
            cliRestoreOriginal(saved, file)
            cliVersionReusesImage(project, path, kof, log, relative)
        }
        var rebuilt = cliChangeKeepingTimestamp(project, project + "/src/main/kof/kofmut/launch/Compatibility.kf", "\n")
        var real = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        cliAssertEvidence(real.exitCode == 0 && real.stdout == "KofMut 0.1.0\n", "changed input must rebuild and launch: " + real.stdout + real.stderr)
        builds = builds + "build\n"
        assert(File(log).readText() == builds, "expected: changed contents compile once")
        assert(Directory(project + "/evaluated/src").createDirectories())
        assert(File(project + "/evaluated/src/Example.kf").writeText("main() { println(1) }\n"))
        var unrelated = process.run("/usr/bin/env", "--chdir=" + project + "/evaluated", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
        assert(unrelated.exitCode == 0)
        assert(File(log).readText() == builds, "evaluated sources must not participate in the tool identity")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

String disposableDistribution(String project, String name) {
    var raw = process.run("kof", "info", "--json")
    assert(raw.exitCode == 0)
    var installed = json.decode<TestInstallation>(raw.stdout)
    var distribution = project + "/" + name
    assert(Directory(distribution + "/bin").createDirectories())
    assert(Directory(distribution + "/lib").createDirectories())
    assert(process.run("/bin/cp", "-a", installed.install + "/bin/kof", distribution + "/bin/kof").exitCode == 0)
    assert(process.run("/bin/cp", "--reflink=auto", "-p", installed.install + "/lib/kof.jar", distribution + "/lib/kof.jar").exitCode == 0)
    assert(process.run("/bin/ln", "-s", installed.install + "/jdk", distribution + "/jdk").exitCode == 0)
    return distribution
}

record TestInstallation(String install)

test "a prepared evaluation uses one work JVM and keeps its own report", "startup-optimization" {
    var project = disposableProject()
    var original = json.decode<TestInstallation>(process.run("kof", "info", "--json").stdout)
    var distribution = disposableDistribution(project, "observed Kof")
    assert(process.run("rm", distribution + "/jdk").exitCode == 0)
    assert(Directory(distribution + "/jdk/bin").createDirectories())
    assert(process.run("cp", "src/test/fixtures/startup-java", distribution + "/jdk/bin/java").exitCode == 0)
    assert(new java.io.File(distribution + "/jdk/bin/java").setExecutable(true, true))
    var log = project + "/work-jvms"
    var command = compatibilityInvocation(project, distribution + "/bin:" + System.getenv("PATH"), distribution + "/bin/kof", project + "/builds")

    var completed = false
    try {
        var prepared = shell.runWith(command, project, mapOf("KOF_MUT_TEST_JAVA", original.install + "/jdk/bin/java"))
        cliAssertEvidence(prepared.exitCode == 3, prepared.stdout + prepared.stderr)
        var warm = shell.runWith(command, project, mapOf("KOF_MUT_TEST_JAVA", original.install + "/jdk/bin/java", "KOF_MUT_JVM_LOG", log))

        cliAssertEvidence(warm.exitCode == 3, warm.stdout + warm.stderr)
        var starts = File(log).readText()
        cliAssertEvidence(starts != null, "work JVM observation is missing")
        if (starts != null) { cliAssertEvidence(starts.trim().split("\n").length == 1, "prepared evaluation must start one work JVM: " + starts) }
        assert(warm.stdout.contains("reportPath="))
        assert(!warm.stderr.contains("checking compatibility"))
        assert(!warm.stderr.contains("preparing application"))
        assert(warm.stdout != prepared.stdout, "each invocation must publish its own report")
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "prepared evaluations repair damaged candidates and revalidate source bytes", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var command = compatibilityInvocation(project, path, kof, project + "/builds")
    var completed = false
    try {
        var first = shell.runWith(command, project, mapOf())
        cliAssertEvidence(first.exitCode == 3, first.stdout + first.stderr)
        var indexes = project + "/build/cache/compatibility/prepared"
        assert(Directory(indexes).list().size == 1, "expected: Directory(indexes).list().size == 1")
        var index = indexes + "/" + Directory(indexes).list().get(0)
        assert(File(index).writeText("truncated candidate"), "expected: File(index).writeText(\"truncated candidate\")")
        var repaired = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
        cliAssertEvidence(repaired.exitCode == 3 && !repaired.stderr.contains("checking compatibility"), repaired.stdout + repaired.stderr)
        for (var relative in listOf("prepared.checksums", "classes/Unexpected.class")) {
            var image = compatibilityRead(index).split("\0")[3]
            var component = image + "/" + relative
            var existed = File(component).exists()
            var saved = ""
            if (existed) { saved = cliSaveOriginal(project, component) }
            assert(File(component).writeText("damaged generated component"), "expected: generated component damaged")
            cliEvaluationRequiresPreparation(command, project, relative)
            if (existed) { cliRestoreOriginal(saved, component) }
            else { assert(File(component).delete(), "expected: unexpected component removed") }
            cliEvaluationReusesApproval(command, project, relative)
            assert(compatibilityRead(index).split("\0")[3] == image, "expected: refused preparation keeps the prepared image")
        }
        for (var relative in listOf("classes/kofmut/launch/PreparedEntry.class")) {
            var descriptor = File(index).readText()
            assert(descriptor != null, "expected: descriptor != null")
            if (descriptor != null) {
                var fields = descriptor.split("\0")
                var oldImage = fields[3]
                assert(File(oldImage + "/" + relative).writeText("damaged generated component"), "expected: File(oldImage + \"/\" + relative).writeText(\"damaged generated component\")")
                var recovered = shell.runWith(command, project, mapOf())
                cliAssertEvidence(recovered.exitCode == 3 && recovered.stderr.contains("checking compatibility"), relative + ": " + recovered.stdout + recovered.stderr)
                assert(!recovered.stderr.contains("ClassFormatError"), "expected: !recovered.stderr.contains(\"ClassFormatError\")")
                assert(!recovered.stderr.contains("Could not find or load main class"), "expected: !recovered.stderr.contains(\"Could not find or load main class\")")
                var updated = File(index).readText()
                assert(updated != null, "expected: updated != null")
                if (updated != null) { assert(updated.split("\0")[3] != oldImage, "expected: updated.split(\"\\0\")[3] != oldImage") }
            }
        }
        var source = project + "/src/main/kof/kofmut/Main.kf"
        var original = File(source).readText()
        assert(original != null, "expected: original != null")
        assert(process.run("cp", "-p", source, project + "/timestamp").exitCode == 0, "expected: process.run(\"cp\", \"-p\", source, project + \"/timestamp\").exitCode == 0")
        if (original != null) { assert(File(source).writeText(original + "\n// changed bytes\n"), "expected: File(source).writeText(original + \"\\n// changed bytes\\n\")") }
        assert(process.run("touch", "-r", project + "/timestamp", source).exitCode == 0, "expected: process.run(\"touch\", \"-r\", project + \"/timestamp\", source).exitCode == 0")
        var changed = shell.runWith(command, project, mapOf())
        cliAssertEvidence(changed.exitCode == 3 && changed.stderr.contains("checking compatibility"), changed.stdout + changed.stderr)
        assert(new java.io.File(source).lastModified() == new java.io.File(project + "/timestamp").lastModified(), "expected: new java.io.File(source).lastModified() == new java.io.File(project + \"/timestamp\").lastModified()")
        if (original != null) { assert(File(source).writeText(original), "expected: File(source).writeText(original)") }
        assert(process.run("touch", "-r", project + "/timestamp", source).exitCode == 0, "expected: process.run(\"touch\", \"-r\", project + \"/timestamp\", source).exitCode == 0")
        var restored = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
        cliAssertEvidence(restored.exitCode == 3 && !restored.stderr.contains("checking compatibility"), restored.stdout + restored.stderr)
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "installation and entire jar contents select a new image with timestamps preserved" {
    var project = disposableProject()
    var path = controlledPath(project)
    var firstDistribution = disposableDistribution(project, "distribution one")
    var secondDistribution = disposableDistribution(project, "distribution two")
    var log = project + "/builds.log"

    var completed = false
    try {
        var first = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + firstDistribution + "/bin/kof", "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(first.exitCode == 0)
        var moved = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + secondDistribution + "/bin/kof", "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(moved.exitCode == 0)
        assert(File(log).readText() == "build\nbuild\n", "same pinned wrapper with another installation must rebuild")
        var jar = secondDistribution + "/lib/kof.jar"
        assert(process.run("/bin/cp", "-p", secondDistribution + "/bin/kof", project + "/timestamp").exitCode == 0)
        assert(process.run("/usr/bin/touch", "-r", jar, project + "/timestamp").exitCode == 0)
        assert(File(project + "/jar-marker").writeText("M1P disposable archive marker\n"))
        assert(process.run(secondDistribution + "/jdk/bin/jar", "--update", "--file", jar, "-C", project, "jar-marker").exitCode == 0)
        assert(process.run("/usr/bin/touch", "-r", project + "/timestamp", jar).exitCode == 0)
        assert(new java.io.File(jar).lastModified() == new java.io.File(project + "/timestamp").lastModified())

        var changed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + secondDistribution + "/bin/kof", "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")

        if (changed.exitCode != 0) { println(changed.stderr) }
        assert(changed.exitCode == 0)
        assert(changed.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\nbuild\nbuild\n", "entire jar bytes must invalidate despite unchanged info and timestamp")
        var reused = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + secondDistribution + "/bin/kof", "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
        assert(reused.exitCode == 0)
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

record LiveLaunch(String processDirectory, String command, Int contexts, String children)

test "warm argument fixture preserves the public invocation without a compiler", "launch-arguments" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var caller = project + "/caller"
    var log = project + "/builds.log"
    assert(Directory(caller).createDirectories(), "expected: Directory(caller).createDirectories()")
    assert(process.run("/bin/cp", "src/test/fixtures/LaunchObservation.kf", project + "/src/main/kof/kofmut/Main.kf").exitCode == 0, "expected: process.run(\"/bin/cp\", \"src/test/fixtures/LaunchObservation.kf\", project + \"/src/main/kof/kofmut/Main.kf\").exitCode == 0")

    var completed = false
    try {
        var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--fixture")
        assert(prepared.exitCode == 23, "expected: prepared.exitCode == 23")

        var result = process.run("/usr/bin/env", "--chdir=" + caller, "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", "KOF_MUT_TEST_VALUE=env 😀 value", project + "/bin/kof-mut", "", "space value", "ação 😀", "line\nbreak", "$(touch INJECTED);*'\"\\", "--target", "not-a-target", "--deps", "missing-dependency")

        assert(result.exitCode == 23, "expected: result.exitCode == 23")
        var observed = json.decode<Observation>(result.stdout)
        assert(observed.arguments.size() == 9, "expected: observed.arguments.size() == 9")
        assert(observed.arguments[0] == "", "expected: observed.arguments[0] == \"\"")
        assert(observed.arguments[1] == "space value", "expected: observed.arguments[1] == \"space value\"")
        assert(observed.arguments[2] == "ação 😀", "expected: observed.arguments[2] == \"ação 😀\"")
        assert(observed.arguments[3] == "line\nbreak", "expected: observed.arguments[3] == \"line\\nbreak\"")
        assert(observed.arguments[4] == "$(touch INJECTED);*'\"\\", "expected: observed.arguments[4] == \"$(touch INJECTED);*'\\\"\\\\\"")
        assert(observed.arguments[5] == "--target", "expected: observed.arguments[5] == \"--target\"")
        assert(observed.arguments[6] == "not-a-target", "expected: observed.arguments[6] == \"not-a-target\"")
        assert(observed.arguments[7] == "--deps", "expected: observed.arguments[7] == \"--deps\"")
        assert(observed.arguments[8] == "missing-dependency", "expected: observed.arguments[8] == \"missing-dependency\"")
        assert(observed.cwd == caller, "expected: observed.cwd == caller")
        assert(observed.environment == "env 😀 value", "expected: observed.environment == \"env 😀 value\"")
        assert(!File(caller + "/INJECTED").exists(), "expected: !File(caller + \"/INJECTED\").exists()")
        assert(File(log).readText() == "build\nbuild\n", "expected: File(log).readText() == \"build\\nbuild\\n\"")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "application consumes its handoff and forwards TERM through the public invocation" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var ready = project + "/application.json"
    var contexts = project + "/contexts"
    var caller = project + "/caller"
    assert(Directory(contexts).createDirectories())
    assert(Directory(caller).createDirectories())
    assert(process.run("/bin/cp", "src/test/fixtures/LaunchLifecycle.kf", project + "/src/main/kof/kofmut/Main.kf").exitCode == 0)
    var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--prepare")
    assert(prepared.exitCode == 23)
    var application = process.spawn("/usr/bin/env", "--chdir=" + caller, "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", "TMPDIR=" + contexts, project + "/bin/kof-mut", ready)
    var pid = ""

    var completed = false
    try {
        var deadline = System.currentTimeMillis() + 10000
        while (!File(ready).exists() && application.alive() && System.currentTimeMillis() < deadline) { Thread.sleep(25) }
        assert(File(ready).exists(), "application must reach its public entry without compilation")
        var raw = File(ready).readText()
        assert(raw != null)
        if (raw != null) {
            var observed = json.decode<LiveLaunch>(raw)
            pid = observed.processDirectory.substring(6)
            assert(observed.command.contains(ready), "the prepared application receives its original arguments")
            assert(observed.contexts == 1, "only the outer signal barrier remains; the application handoff was removed")
            assert(observed.children == "", "launch JVM must not supervise another application process")
        }
        assert(File(log).readText() == "build\nbuild\n")
        assert(process.run("/bin/kill", "-TERM", pid).exitCode == 0)
        deadline = System.currentTimeMillis() + 10000
        while (application.alive() && System.currentTimeMillis() < deadline) { Thread.sleep(25) }
        assert(!application.alive(), "TERM must terminate the public invocation")
        assert(application.exitCode() == 143)
        assert(!File("/proc/" + pid).exists())
        assert(Directory(contexts).list().size() == 0)
        completed = true
    } finally {
        if (pid != "" && File("/proc/" + pid).exists()) { var killed = process.run("/bin/kill", "-KILL", pid) }
        if (application.alive()) { application.kill() }
        cliCleanup(project, completed)
    }
}

test "runtime rejects altered fresh evidence and removes its context on failure", "compatibility-context-errors" {
    var project = disposableProject()
    var path = controlledPath(project)
    var original = json.decode<TestInstallation>(process.run("kof", "info", "--json").stdout)
    var distribution = disposableDistribution(project, "controlled runtime")
    assert(process.run("/bin/rm", distribution + "/jdk").exitCode == 0)
    assert(Directory(distribution + "/jdk/bin").createDirectories())
    assert(process.run("/bin/cp", "-a", "src/test/fixtures/controlled-java/java", distribution + "/jdk/bin/java").exitCode == 0)
    var contexts = project + "/contexts"
    assert(Directory(contexts).createDirectories())
    var log = project + "/builds.log"

    var completed = false
    try {
        var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + distribution + "/bin/kof", "KOF_MUT_TEST_JAVA=" + original.install + "/jdk/bin/java", "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(prepared.exitCode == 0)

        var rejected = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + distribution + "/bin/kof", "KOF_MUT_TEST_JAVA=" + original.install + "/jdk/bin/java", "KOF_MUT_TEST_COMPILE=refuse", "KOF_MUT_TEST_CONTEXT=invalid-json", "TMPDIR=" + contexts, project + "/bin/kof-mut", "--version")

        assert(rejected.exitCode == 2, "compiled entry must reject invalid fresh evidence itself")
        assert(rejected.stdout == "")
        assert(rejected.stderr.contains("kof-mut:"))
        assert(File(log).readText() == "build\n")
        assert(Directory(contexts).list().size() == 0, "failed runtime validation must remove its context")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "truncated location delivery triggers preparation instead of direct execution" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(prepared.exitCode == 0)
        var locations = project + "/build/cache/kof-launch-v2/locations"
        var names = Directory(locations).list()
        assert(names.size() == 1)
        var descriptor = locations + "/" + names[0]
        var raw = File(descriptor).readText()
        assert(raw != null)
        if (raw != null) { assert(File(descriptor).writeText(raw.substring(0, raw.length() - 1))) }

        var rejected = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")

        assert(rejected.exitCode == 2, "an unterminated descriptor must trigger preparation, which is refused here")
        assert(rejected.stdout == "")
        var recovered = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(recovered.exitCode == 0)
        assert(recovered.stdout == "KofMut 0.1.0\n")
        var repaired = File(descriptor).readText()
        assert(repaired != null)
        if (repaired != null && raw != null) { assert(repaired.equals(raw), "repaired descriptor must preserve all original fields") }
        assert(File(log).readText() == "build\n", "descriptor repair must retain the complete image")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

test "jar hash failure returns two and cannot execute the warm image" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"

    var completed = false
    try {
        var prepared = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        assert(prepared.exitCode == 0)
        assert(File(project + "/toolchain/b2sum").writeText("#!/bin/sh\necho 'controlled jar hash failure' >&2\nexit 7\n"))
        assert(process.run("/bin/chmod", "+x", project + "/toolchain/b2sum").exitCode == 0)

        var failed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")

        assert(failed.exitCode == 2, "failure to validate jar contents must return 2")
        assert(failed.stdout == "")
        assert(failed.stderr.contains("controlled jar hash failure"))
        assert(File(log).readText() == "build\n")
        assert(File(project + "/toolchain/b2sum").delete())
        var retry = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
        assert(retry.exitCode == 0)
        assert(retry.stdout == "KofMut 0.1.0\n")
        assert(File(log).readText() == "build\n")
        completed = true
    } finally {
        cliCleanup(project, completed)
    }
}

List<String> compatibilityInvocation(String project, String path, String kof, String log) {
    var evaluated = new java.io.File("fixtures/detected").getCanonicalPath()
    assert(File(project + "/empty-scope.json").writeText("[]"))
    return listOf("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "run", "--project", evaluated, "--files", project + "/empty-scope.json", "--report-dir", project + "/reports")
}

test "a new Kof prepares and checks compatibility once before evaluation", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)

    var completed = false
    try {
        var first = shell.runWith(command, project, mapOf())
        if (first.exitCode != 3) { println(first.stdout + first.stderr) }
        cliAssertEvidence(first.exitCode == 3, first.stdout + first.stderr)
        cliAssertEvidence(first.stderr.contains("detected; preparing application..."), first.stderr)
        assert(first.stderr.contains("kof-mut: checking compatibility..."), "expected: first.stderr.contains(\"kof-mut: checking compatibility...\")")
        assert(first.stderr.contains("kof-mut: ready; starting evaluation."), "expected: first.stderr.contains(\"kof-mut: ready; starting evaluation.\")")
        assert(first.stdout.contains("reportPath="), "expected: first.stdout.contains(\"reportPath=\")")
        var builds = File(log).readText()
        assert(builds != null, "expected: builds != null")

        var second = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
        if (second.exitCode != 3) { println(second.stdout + second.stderr) }
        cliAssertEvidence(second.exitCode == 3, second.stdout + second.stderr)
        assert(!second.stderr.contains("preparing application"), "expected: !second.stderr.contains(\"preparing application\")")
        assert(!second.stderr.contains("checking compatibility"), "expected: !second.stderr.contains(\"checking compatibility\")")
        assert(!second.stderr.contains("ready; starting evaluation"), "expected: !second.stderr.contains(\"ready; starting evaluation\")")
        assert(second.stdout.contains("reportPath="), "expected: second.stdout.contains(\"reportPath=\")")
        if (builds != null) { assert(builds.equals(File(log).readText()), "expected: builds.equals(File(log).readText())") }
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "compilation alone cannot approve a frontend behavior change and retry repairs it", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    var file = project + "/src/main/kof/kofmut/Frontend.kf"
    var original = File(file).readText()
    assert(original != null, "expected: original != null")

    var completed = false
    try {
        if (original != null) { assert(File(file).writeText(original.replace("return \"arithmetic\"", "return \"wrong-family\"")), "expected: File(file).writeText(original.replace(\"return \\\"arithmetic\\\"\", \"return \\\"wrong-family\\\"\"))") }
        var refused = shell.runWith(command, project, mapOf())
        assert(refused.exitCode == 2, "expected: refused.exitCode == 2")
        assert(refused.stdout == "", "expected: refused.stdout == \"\"")
        cliAssertEvidence(refused.stderr.contains("preparation contracts failed"), refused.stderr)
        assert(refused.stderr.contains("compatibility killed verification failed"), "expected: refused.stderr.contains(\"compatibility killed verification failed\")")
        assert(refused.stderr.contains("evidence:"), "expected: refused.stderr.contains(\"evidence:\")")
        assert(!refused.stderr.contains("ready; starting evaluation"), "expected: !refused.stderr.contains(\"ready; starting evaluation\")")
        assert(!File(project + "/reports").exists(), "expected: !File(project + \"/reports\").exists()")
        assert(File(log).readText() == "build\nbuild\n", "the candidate compiled before behavioral refusal")

        if (original != null) { assert(File(file).writeText(original), "expected: File(file).writeText(original)") }
        var retry = shell.runWith(command, project, mapOf())
        cliAssertEvidence(retry.exitCode == 3, retry.stdout + retry.stderr)
        assert(retry.stderr.contains("ready; starting evaluation"), "expected: retry.stderr.contains(\"ready; starting evaluation\")")
        assert(retry.stdout.contains("reportPath="), "expected: retry.stdout.contains(\"reportPath=\")")
        assert(File(log).readText() == "build\nbuild\nbuild\n", "expected: File(log).readText() == \"build\\nbuild\\nbuild\\n\"")
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "concurrent first evaluations share one complete preparation", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    assert(File(project + "/concurrent.sh").writeText("#!/bin/bash\n\"$@\" > first.stdout 2> first.stderr &\na=$!\n\"$@\" > second.stdout 2> second.stderr &\nb=$!\nwait $a; x=$?\nwait $b; y=$?\n[[ $x == 3 && $y == 3 ]]\n"), "expected: File(project + \"/concurrent.sh\").writeText(\"#!/bin/bash\\n\\\"$@\\\" > first.stdout 2> first.stderr &\\na=$!\\n\\\"$@\\\" > second.stdout 2> second.stderr &\\nb=$!\\nwait $a; x=$?\\nwait $b; y=$?\\n[[ $x == 3 && $y == 3 ]]\\n\")")
    var invocation = listOf("/bin/bash", project + "/concurrent.sh")
    for (var arg in command) { invocation.add(arg) }

    var completed = false
    try {
        var result = shell.runWith(invocation, project, mapOf())
        assert(result.exitCode == 0, "expected: result.exitCode == 0")
        assert(File(log).readText() == "build\nbuild\n", "one bootstrap and one application build")
        var first = File(project + "/first.stdout").readText()
        var second = File(project + "/second.stdout").readText()
        assert(first != null && second != null, "expected: first != null && second != null")
        if (first != null && second != null) { assert(first.contains("reportPath="), "expected: first.contains(\"reportPath=\")"); assert(second.contains("reportPath="), "expected: second.contains(\"reportPath=\")"); assert(!first.equals(second), "expected: !first.equals(second)") }
        completed = true
    } finally { cliCleanup(project, completed) }
}

String compatibilityRead(String path) {
    var text = File(path).readText()
    if (text != null) { return text }
    throw "missing evidence: " + path
}

Process startCompatibility(List<String> command, String log) {
    var argv = new String[command.size]
    for (var i = 0; i < command.size; i++) { argv[i] = command.get(i) }
    var builder = new java.lang.ProcessBuilder(argv)
    builder.redirectOutput(new java.io.File(log + ".stdout"))
    builder.redirectError(new java.io.File(log + ".stderr"))
    return builder.start()
}

Bool compatibilityProcessActive(String pid) {
    var result = process.run("/bin/ps", "-o", "stat=", "-p", pid)
    return result.exitCode == 0 && result.stdout.trim() != "" && !result.stdout.trim().startsWith("Z")
}

test "INT and TERM discard an emitted candidate and allow retry without cleanup", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    var warmed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
    assert(warmed.exitCode == 0, "expected: warmed.exitCode == 0")

    var completed = false
    try {
        for (var signal in listOf("INT", "TERM")) {
            // Change engine contents so each signal meets a fresh candidate.
            var source = project + "/src/main/kof/kofmut/Main.kf"
            assert(File(source).writeText(compatibilityRead(source) + "\n"), "expected: File(source).writeText(compatibilityRead(source) + \"\\n\")")
            var ready = project + "/ready-" + signal
            var invocation = listOf("/usr/bin/env", "KOF_MUT_TEST_BUILD=block-after-output", "KOF_MUT_TEST_READY=" + ready)
            for (var arg in command) { invocation.add(arg) }
            var started = System.nanoTime()
            var child = startCompatibility(invocation, project + "/cancel-" + signal)
            try {
                cliAwaitDuringPreparation(ready, child, started)
                assert(File(ready).exists(), "emitted candidate readiness")
                var compilerPid = compatibilityRead(ready + ".pid").trim()
                var candidate = compatibilityRead(ready).trim()
                assert(File(candidate + "/classes/Default/Main.class").isFile(), "expected: File(candidate + \"/classes/Default/Main.class\").isFile()")
                var pid = "" + child.pid()
                assert(process.run("/bin/kill", "-" + signal, pid).exitCode == 0, "expected: process.run(\"/bin/kill\", \"-\" + signal, pid).exitCode == 0")
                assert(child.waitFor(5000 as Long, TimeUnit.MILLISECONDS), "expected: child.waitFor(5000 as Long, TimeUnit.MILLISECONDS)")
                var expected = 130
                if (signal == "TERM") { expected = 143 }
                assert(child.exitValue() == expected, "expected: child.exitValue() == expected")
                assert(!compatibilityProcessActive(compilerPid), "compiler stopped before test cleanup")
                assert(!File(candidate + "/approval.json").exists(), "expected: !File(candidate + \"/approval.json\").exists()")
                assert(File(ready + ".continue").writeText("release"), "expected: File(ready + \".continue\").writeText(\"release\")")
                Thread.sleep(100 as Long)
                assert(!File(candidate + "/approval.json").exists(), "no late approval")
            } finally { if (child.isAlive()) { child.destroyForcibly() } }
            var retry = shell.runWith(command, project, mapOf())
            cliAssertEvidence(retry.exitCode == 3, retry.stdout + retry.stderr)
            assert(retry.stderr.contains("ready; starting evaluation"), "expected: retry.stderr.contains(\"ready; starting evaluation\")")
        }
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "a preparation command timeout refuses evaluation and retry needs no cache cleanup", "compatibility", "compatibility-timeout" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    var warmed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
    cliAssertEvidence(warmed.exitCode == 0, warmed.stdout + warmed.stderr)
    var ready = project + "/timeout-ready"
    var invocation = listOf("/usr/bin/env", "KOF_MUT_TEST_BUILD=block-before-output", "KOF_MUT_TEST_READY=" + ready)
    for (var arg in command) { invocation.add(arg) }
    var started = System.nanoTime()
    var child = startCompatibility(invocation, project + "/command-timeout")

    var completed = false
    try {
        while (!File(ready).exists() && child.isAlive() && System.nanoTime() - started < 90000000000) { Thread.sleep(20 as Long) }
        cliAssertEvidence(File(ready).exists(), "compiler readiness: " + compatibilityRead(project + "/command-timeout.stderr"))
        var commandStarted = System.nanoTime()
        var finished = child.waitFor(32000 as Long, TimeUnit.MILLISECONDS)
        var commandElapsed = (System.nanoTime() - commandStarted) / 1000000
        var elapsed = (System.nanoTime() - started) / 1000000
        var error = compatibilityRead(project + "/command-timeout.stderr")
        println("timeout observation: preparationMs=" + elapsed + "; observedCommandAndCleanupMs=" + commandElapsed + "; stderr=" + error)
        cliAssertEvidence(finished, "command must stop within thirty seconds plus two shared cleanup seconds: " + commandElapsed)
        cliAssertEvidence(commandElapsed >= 29000, "command was stopped before its thirty second deadline: " + commandElapsed)
        cliAssertEvidence(child.exitValue() == 2, error)
        cliAssertEvidence(elapsed < 92000, "preparation plus cleanup exceeded its total bound: " + elapsed)
        assert(compatibilityRead(project + "/command-timeout.stdout") == "", "expected: compatibilityRead(project + \"/command-timeout.stdout\") == \"\"")
        assert(error.contains("preparation compile failed"), "expected: error.contains(\"preparation compile failed\")")
        assert(error.contains("30000 ms maximum"), "expected: error.contains(\"30000 ms maximum\")")
        assert(error.contains("evidence:"), "expected: error.contains(\"evidence:\")")
        assert(!File(project + "/reports").exists(), "expected: !File(project + \"/reports\").exists()")
        assert(Directory(project + "/build/cache/compatibility/approved").list().size() == 0, "timeout cannot publish compatibility approval")
        assert(!compatibilityProcessActive(compatibilityRead(ready + ".pid").trim()), "expected: !compatibilityProcessActive(compatibilityRead(ready + \".pid\").trim())")
        var retry = shell.runWith(command, project, mapOf())
        cliAssertEvidence(retry.exitCode == 3, retry.stdout + retry.stderr)
        assert(retry.stderr.contains("ready; starting evaluation"), "expected: retry.stderr.contains(\"ready; starting evaluation\")")
        completed = true
    } finally {
        if (child.isAlive()) { child.destroy(); var stopped = child.waitFor(5000 as Long, TimeUnit.MILLISECONDS); if (child.isAlive()) { child.destroyForcibly() } }
        cliCleanup(project, completed)
    }
}

test "contents changing during preparation cannot publish approval even with preserved timestamps", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    var warmed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
    assert(warmed.exitCode == 0, "expected: warmed.exitCode == 0")
    var ready = project + "/integrity-ready"
    var invocation = listOf("/usr/bin/env", "KOF_MUT_TEST_BUILD=block-after-output", "KOF_MUT_TEST_READY=" + ready)
    for (var arg in command) { invocation.add(arg) }
    var started = System.nanoTime()
    var child = startCompatibility(invocation, project + "/integrity")

    var completed = false
    try {
        cliAwaitDuringPreparation(ready, child, started)
        assert(File(ready).exists(), "expected: File(ready).exists()")
        var source = project + "/src/main/kof/kofmut/Main.kf"
        assert(process.run("/bin/cp", "-p", source, project + "/timestamp").exitCode == 0, "expected: process.run(\"/bin/cp\", \"-p\", source, project + \"/timestamp\").exitCode == 0")
        assert(File(source).writeText(compatibilityRead(source) + "\n"), "expected: File(source).writeText(compatibilityRead(source) + \"\\n\")")
        assert(process.run("/usr/bin/touch", "-r", project + "/timestamp", source).exitCode == 0, "expected: process.run(\"/usr/bin/touch\", \"-r\", project + \"/timestamp\", source).exitCode == 0")
        assert(new java.io.File(source).lastModified() == new java.io.File(project + "/timestamp").lastModified(), "expected: new java.io.File(source).lastModified() == new java.io.File(project + \"/timestamp\").lastModified()")
        assert(File(ready + ".continue").writeText("go"), "expected: File(ready + \".continue\").writeText(\"go\")")
        var remaining = cliPreparationDeadlineWithCleanupMs() - cliElapsedMs(started)
        if (remaining < 0) { remaining = 0 }
        var finished = child.waitFor(remaining, TimeUnit.MILLISECONDS)
        cliAssertEvidence(finished, "integrity preparation did not finish within " + cliPreparationDeadlineWithCleanupMs() + " ms of invocation start; elapsed " + cliElapsedMs(started) + " ms")
        assert(child.exitValue() == 2, "expected: child.exitValue() == 2")
        var error = compatibilityRead(project + "/integrity.stderr")
        assert(error.contains("preparation integrity failed"), "expected: error.contains(\"preparation integrity failed\")")
        assert(error.contains("components changed during preparation; retry"), "expected: error.contains(\"components changed during preparation; retry\")")
        assert(compatibilityRead(project + "/integrity.stdout") == "", "expected: compatibilityRead(project + \"/integrity.stdout\") == \"\"")
        assert(!File(project + "/reports").exists(), "expected: !File(project + \"/reports\").exists()")
        var retry = shell.runWith(command, project, mapOf())
        cliAssertEvidence(retry.exitCode == 3, retry.stdout + retry.stderr)
        assert(retry.stderr.contains("ready; starting evaluation"), "expected: retry.stderr.contains(\"ready; starting evaluation\")")
        var reused = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
        assert(reused.exitCode == 3, "expected: reused.exitCode == 3")
        assert(!reused.stderr.contains("checking compatibility"), "expected: !reused.stderr.contains(\"checking compatibility\")")
        completed = true
    } finally { if (child.isAlive()) { child.destroyForcibly() }; cliCleanup(project, completed) }
}

test "all informational commands avoid engine compilation even with invalid engine syntax", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    assert(File(project + "/src/main/kof/kofmut/Main.kf").writeText("invalid engine syntax {"), "expected: File(project + \"/src/main/kof/kofmut/Main.kf\").writeText(\"invalid engine syntax {\")")

    var completed = false
    try {
        for (var option in listOf("--version", "--help", "-h", "")) {
            var command = listOf("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut")
            if (option != "") { command.add(option) }
            var result = shell.runWith(command, project, mapOf())
            cliAssertEvidence(result.exitCode == 0, result.stdout + result.stderr)
            assert(result.stdout.contains("KofMut"), "expected: result.stdout.contains(\"KofMut\")")
            assert(!result.stderr.contains("preparing application"), "expected: !result.stderr.contains(\"preparing application\")")
            assert(!result.stderr.contains("checking compatibility"), "expected: !result.stderr.contains(\"checking compatibility\")")
            assert(!result.stderr.contains("ready; starting evaluation"), "expected: !result.stderr.contains(\"ready; starting evaluation\")")
            assert(File(log).readText() == "build\n", "only the minimal bootstrap compiles")
        }
        assert(!File(project + "/build/cache/compatibility/images").exists(), "expected: !File(project + \"/build/cache/compatibility/images\").exists()")
        var run = shell.runWith(compatibilityInvocation(project, path, kof, log), project, mapOf())
        assert(run.exitCode == 2, "expected: run.exitCode == 2")
        assert(run.stderr.contains("preparation compile failed"), "expected: run.stderr.contains(\"preparation compile failed\")")
        assert(run.stdout == "", "expected: run.stdout == \"\"")
        completed = true
    } finally { cliCleanup(project, completed) }
}

test "JDK contents invalidate approval with the same declared version and timestamps", "compatibility", "startup-optimization" {
    var project = disposableProject()
    var path = controlledPath(project)
    var installed = json.decode<TestInstallation>(process.run("kof", "info", "--json").stdout)
    var distribution = project + "/copied Kof"
    assert(process.run("cp", "-a", "--reflink=auto", installed.install, distribution).exitCode == 0, "expected: process.run(\"cp\", \"-a\", \"--reflink=auto\", installed.install, distribution).exitCode == 0")
    var kof = distribution + "/bin/kof"
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)

    var completed = false
    try {
        var first = shell.runWith(command, project, mapOf())
        cliAssertEvidence(first.exitCode == 3, first.stdout + first.stderr)
        assert(File(log).readText() == "build\nbuild\n", "expected: File(log).readText() == \"build\\nbuild\\n\"")
        var expected = "build\nbuild\n"
        var release = distribution + "/jdk/release"
        var saved = cliChangeKeepingTimestamp(project, release, "\n# compatibility content proof\n")
        cliEvaluationRequiresPreparation(command, project, "jdk/release")
        assert(File(log).readText() == expected, "expected: refused preparation does not build")
        cliRestoreOriginal(saved, release)
        cliEvaluationReusesApproval(command, project, "jdk/release")
        for (var relative in listOf("jdk/lib/jvm.cfg")) {
            var file = distribution + "/" + relative
            assert(process.run("cp", "-p", file, project + "/timestamp").exitCode == 0, "expected: process.run(\"cp\", \"-p\", file, project + \"/timestamp\").exitCode == 0")
            assert(File(file).writeText(compatibilityRead(file) + "\n# compatibility content proof\n"), "expected: File(file).writeText(compatibilityRead(file) + \"\\n# compatibility content proof\\n\")")
            assert(process.run("touch", "-r", project + "/timestamp", file).exitCode == 0, "expected: process.run(\"touch\", \"-r\", project + \"/timestamp\", file).exitCode == 0")
            assert(new java.io.File(file).lastModified() == new java.io.File(project + "/timestamp").lastModified(), "expected: new java.io.File(file).lastModified() == new java.io.File(project + \"/timestamp\").lastModified()")
            var changed = shell.runWith(command, project, mapOf())
            cliAssertEvidence(changed.exitCode == 3, changed.stdout + changed.stderr)
            assert(changed.stderr.contains("checking compatibility"), "expected: changed.stderr.contains(\"checking compatibility\")")
            expected = expected + "build\n"
            assert(File(log).readText() == expected, "expected: File(log).readText() == expected")
            var reused = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
            assert(reused.exitCode == 3, "expected: reused.exitCode == 3")
            assert(!reused.stderr.contains("checking compatibility"), "expected: !reused.stderr.contains(\"checking compatibility\")")
            assert(File(log).readText() == expected, "expected: File(log).readText() == expected")
        }
        completed = true
    } finally { cliCleanup(project, completed) }
}

Long cliPreparationDeadlineWithCleanupMs() { return 92000 as Long }

Long cliElapsedMs(Long started) { return (System.nanoTime() - started) / 1000000 }

void cliAwaitDuringPreparation(String path, Process child, Long started) {
    while (!File(path).exists() && child.isAlive() && cliElapsedMs(started) < cliPreparationDeadlineWithCleanupMs()) { Thread.sleep(20 as Long) }
}

void cliAssertEvidence(Bool condition, String evidence) {
    if (!condition) { println(evidence) }
    assert(condition, "behavior failed; see evidence above")
}

String cliSaveOriginal(String project, String file) {
    var saved = project + "/original"
    assert(process.run("/bin/cp", "-p", file, saved).exitCode == 0, "expected: original bytes and timestamp saved")
    return saved
}

String cliChangeKeepingTimestamp(String project, String file, String appended) {
    var saved = cliSaveOriginal(project, file)
    assert(File(file).writeText(compatibilityRead(file) + appended), "expected: bytes changed")
    assert(process.run("/usr/bin/touch", "-r", saved, file).exitCode == 0, "expected: timestamp restored")
    assert(new java.io.File(file).lastModified() == new java.io.File(saved).lastModified(), "expected: timestamp preserved")
    return saved
}

void cliRestoreOriginal(String saved, String file) {
    assert(process.run("/bin/cp", "-p", saved, file).exitCode == 0, "expected: original bytes restored with their timestamp")
}

void cliVersionRequiresPreparation(String project, String path, String kof, String log, String builds, String subject) {
    var refused = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
    cliAssertEvidence(refused.exitCode == 2 && refused.stdout == "" && refused.stderr.contains("controlled toolchain refuses compilation"), subject + " must require preparation: " + refused.stdout + refused.stderr)
    cliAssertEvidence(File(log).readText() == builds, subject + ": refused preparation must not build")
}

void cliVersionReusesImage(String project, String path, String kof, String log, String subject) {
    var reused = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, "KOF_MUT_TEST_COMPILE=refuse", project + "/bin/kof-mut", "--version")
    cliAssertEvidence(reused.exitCode == 0 && reused.stdout == "KofMut 0.1.0\n", subject + " restored must reuse its image: " + reused.stdout + reused.stderr)
}

void cliEvaluationRequiresPreparation(List<String> command, String project, String subject) {
    var refused = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
    cliAssertEvidence(refused.exitCode == 2 && refused.stdout == "" && refused.stderr.contains("preparation compile failed") && !refused.stderr.contains("checking compatibility"), subject + " must require preparation: " + refused.stdout + refused.stderr)
}

void cliEvaluationReusesApproval(List<String> command, String project, String subject) {
    var reused = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
    cliAssertEvidence(reused.exitCode == 3 && !reused.stderr.contains("checking compatibility"), subject + " restored must reuse its approval: " + reused.stdout + reused.stderr)
}

void cliCleanup(String project, Bool completed) {
    if (!completed) {
        println("evidence retained: " + project)
        return
    }
    assert(Directory(project).delete(), "disposable project removed after a completed test")
}

record CompatibilityTiming(Long durationMs)

test "slow compilation and mutation trials retain real behavioral approval", "compatibility", "compatibility-limits" {
    var project = disposableProject()
    var path = controlledPath(project)
    var kof = process.run("/usr/bin/which", "kof").stdout.trim()
    var log = project + "/builds.log"
    var command = compatibilityInvocation(project, path, kof, log)
    var completed = false
    try {
        var warmed = process.run("/usr/bin/env", "PATH=" + path, "KOF_MUT_TEST_KOF=" + kof, "KOF_MUT_TEST_LOG=" + log, project + "/bin/kof-mut", "--version")
        cliAssertEvidence(warmed.exitCode == 0, warmed.stdout + warmed.stderr)
        var first = shell.runWith(command, project, mapOf("KOF_MUT_TEST_BUILD_DELAY", "11", "KOF_MUT_TEST_COMMAND_DELAY", "1.5"))
        cliAssertEvidence(first.exitCode == 3, first.stdout + first.stderr)
        assert(first.stderr.contains("ready; starting evaluation"), "expected: first.stderr.contains(\"ready; starting evaluation\")")
        var reports = process.run("/usr/bin/find", project + "/.agent/tmp/m6", "-path", "*-reports/*/*/report.json")
        assert(reports.exitCode == 0, "expected: reports.exitCode == 0")
        var count = 0
        for (var report in reports.stdout.trim().split("\n")) {
            var timing = json.decode<CompatibilityTiming>(compatibilityRead(report))
            cliAssertEvidence(timing.durationMs > 8500 && timing.durationMs < 25000, "internal mutation trial durationMs=" + timing.durationMs)
            println("slow compatibility report=" + report + "; durationMs=" + timing.durationMs)
            count++
        }
        assert(count == 2, "both detection and survival must complete beyond the old budget")
        var reused = shell.runWith(command, project, mapOf("KOF_MUT_TEST_COMPILE", "refuse"))
        cliAssertEvidence(reused.exitCode == 3, reused.stdout + reused.stderr)
        assert(!reused.stderr.contains("checking compatibility"), "expected: !reused.stderr.contains(\"checking compatibility\")")
        completed = true
    } finally { cliCleanup(project, completed) }
}

List<String> observerRows(String path) {
    var rows: List<String> = listOf()
    var text = File(path).readText()
    if (text == null) { return rows }
    var lines = text.split("\n")
    for (var i = 1; i < lines.length; i++) { if (lines[i] != "") { rows.add(lines[i]) } }
    return rows
}

Bool observerAlive(String observations) {
    return process.run("/usr/bin/pgrep", "-f", observations).exitCode == 0
}

test "check observer preserves the command status and records its process tree", "check-observer" {
    var project = disposableProject()
    var observations = project + "/observations"
    var orphan = ""

    var completed = false
    try {
        var started = System.nanoTime()
        var child = startCompatibility(listOf(project + "/scripts/observe", observations, "synthetic", "--", "/bin/bash", "-c", "setsid /bin/sleep 30 < /dev/null > /dev/null 2>&1 & /bin/sleep 3; exit 7"), project + "/observe")
        var finished = child.waitFor(15000 as Long, TimeUnit.MILLISECONDS)
        var elapsed = (System.nanoTime() - started) / 1000000
        assert(finished, "expected: observer finished within 15000 ms")
        assert(child.exitValue() == 7, "expected: observer returns the command exit status 7")
        cliAssertEvidence(elapsed < 8000, "observer outlived its 3000 ms command; elapsed " + elapsed + " ms")
        var leftovers = compatibilityRead(observations + "/leftover.txt")
        for (var line in leftovers.split("\n")) { if (line.endsWith("/bin/sleep 30")) { orphan = line.split("\t")[0] } }
        cliAssertEvidence(orphan != "", "detached process missing from leftover list: " + leftovers)
        var samples = observerRows(observations + "/samples.tsv")
        assert(samples.size() >= 1, "expected: at least one sample row")
        var tree = false
        for (var row in samples) {
            var fields = row.split("\t")
            assert(fields[0] == "synthetic", "expected: samples name their stage")
            if (fields.length > 7 && Integer.parseInt(fields[7]) >= 2) { tree = true }
        }
        cliAssertEvidence(tree, "no sample counted the command and its child: " + samples)
        var stages = observerRows(observations + "/stages.tsv")
        cliAssertEvidence(stages.size() == 1 && stages.get(0).startsWith("synthetic\t") && stages.get(0).endsWith("\t7"), "stage timing missing or wrong: " + stages)
        assert(!observerAlive(observations), "expected: no observer process remains alive")
        completed = true
    } finally {
        if (orphan != "") { var killed = process.run("/bin/kill", "-KILL", orphan) }
        cliCleanup(project, completed)
    }
}

test "check observer forwards TERM and keeps its samples", "check-observer" {
    var project = disposableProject()
    var observations = project + "/observations"

    var completed = false
    var child = startCompatibility(listOf(project + "/scripts/observe", observations, "synthetic", "--", "/bin/sleep", "30"), project + "/observe")
    try {
        var started = System.nanoTime()
        while (observerRows(observations + "/samples.tsv").size() == 0 && child.isAlive() && (System.nanoTime() - started) / 1000000 < 10000) { Thread.sleep(20 as Long) }
        assert(observerRows(observations + "/samples.tsv").size() >= 1, "expected: a sample row before TERM")
        assert(process.run("/bin/kill", "-TERM", "" + child.pid()).exitCode == 0, "expected: TERM delivered to the observer")
        var finished = child.waitFor(10000 as Long, TimeUnit.MILLISECONDS)
        assert(finished, "expected: observer finished within 10000 ms of TERM")
        assert(child.exitValue() == 143, "expected: TERM yields exit status 143")
        assert(observerRows(observations + "/samples.tsv").size() >= 1, "expected: samples kept after TERM")
        var stages = observerRows(observations + "/stages.tsv")
        cliAssertEvidence(stages.size() == 1 && stages.get(0).endsWith("\t143"), "stage timing missing or wrong: " + stages)
        var leftovers = compatibilityRead(observations + "/leftover.txt")
        cliAssertEvidence(!leftovers.contains("/bin/sleep 30"), "TERM did not reach the command: " + leftovers)
        assert(!observerAlive(observations), "expected: no observer process remains alive")
        completed = true
    } finally {
        if (child.isAlive()) { child.destroyForcibly() }
        cliCleanup(project, completed)
    }
}
