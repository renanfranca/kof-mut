package kofmut

binaryTokenLocation() {
    var source = "Bool less(Int a, Int b) { return a < b }"

    var result = scanSource(source, "Example.kf")

    assert(result.limitations.size == 0)
    assert(result.errors.size == 0)
    assert(result.sites.size == 1)
    var site = result.sites.get(0)
    assert(site.original == "<")
    assert(site.replacement == "<=")
    assert(site.offset == 35)
    assert(site.line == 1)
    assert(site.column == 36)
    assert(site.length == 1)
    println("PASS frontend: binary expression maps to its exact operator token")
}

memberAndLambdaTraversal() {
    var source = "class Gauge { Bool ready = 1 < 2 constructor() { var created = 2 < 3 } Bool less(Int a, Int b) { return a < b } } Bool check() { var less = (x: Int) -> x < 3 return less(2) }"

    var result = scanSource(source, "Forms.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    assert(result.sites.size == 4)
    assert(result.sites.get(0).offset == 29)
    assert(result.sites.get(1).offset == 65)
    assert(result.sites.get(2).offset == 106)
    assert(result.sites.get(3).offset == 154)
    println("PASS frontend: fields, constructors, methods and lambdas are traversed")
}

fileReading() {
    var result = scanFile("src/test/fixtures/Comparison.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    assert(result.sites.size == 1)
    assert(result.sites.get(0).offset == 35)
    println("PASS frontend: source files are read through Kof IO")
}

repeatedNestedOperators() {
    var source = "Bool nested(Int a, Int b, Int c) { return (a < b) && (b < c) }"

    var result = scanSource(source, "Nested.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    assert(result.sites.size == 3)
    assert(result.sites.get(0).offset == 45)
    assert(result.sites.get(1).offset == 56)
    assert(result.sites.get(2).offset == 50)
    println("PASS frontend: repeated nested operators retain distinct token locations")
}

nonExpressionSymbols() {
    var source = "Bool less(List<Int> xs, Int x) { var text = \"<\" // < ignored\n return x < 2 }"

    var result = scanSource(source, "Symbols.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    assert(result.sites.size == 1)
    assert(result.sites.get(0).offset == 71)
    assert(result.sites.get(0).line == 2)
    assert(result.sites.get(0).column == 11)
    println("PASS frontend: comments, strings and generic delimiters are excluded")
}

unicodeLocations() {
    var source = "Bool less(Int x) { var text = \"😀\" return x < 2 }\r\n"

    var result = scanSource(source, "Unicode.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    assert(result.sites.size == 1)
    var site = result.sites.get(0)
    assert(site.offset == 44)
    assert(site.column == 45)
    assert(site.line == 1)
    assert(source.substring(site.offset, site.offset + site.length) == "<")

    var multiline = scanSource("Bool less(Int x) {\r\n var text = \"😀\" return x < 2\r\n}", "Multiline.kf")
    assert(multiline.errors.size == 0)
    assert(multiline.limitations.size == 0)
    assert(multiline.sites.size == 1)
    assert(multiline.sites.get(0).offset == 46)
    assert(multiline.sites.get(0).line == 2)
    assert(multiline.sites.get(0).column == 27)
    println("PASS frontend: Unicode offsets use JVM UTF-16 indices with CRLF input")
}

frontendErrors() {
    var lexical = scanSource("Bool broken() { return \"unterminated", "Lexical.kf")
    assert(lexical.errors.size > 0)
    assert(lexical.errors.get(0).contains("LEX002"))
    assert(lexical.sites.size == 0)

    var syntactic = scanSource("Bool less(Int a, Int b) { return a < b", "Syntax.kf")
    assert(syntactic.errors.size > 0)
    assert(syntactic.errors.get(0).contains("PARSE"))
    assert(syntactic.sites.size == 0)
    println("PASS frontend: lexer and parser errors prevent candidate generation")
}

controlFlowTraversal() {
    var source = "Int choose(Int n) { var total = n + 1 if (n < 2) { total = total - 1 } else { total = total * 2 } while (total > 4) { total = total / 2 } do { total = total + 1 } while (total <= 0) for (var i = 0; i != 2; i++) { total = total + i } for (var x in listOf(1)) { total = total + x } switch (n) { case 1: total = total - 1 break default: total = total * 1 } try { total = total + 1 } catch (String e) { total = total - 1 } finally { total = total * 1 } return total }"

    var result = scanSource(source, "Control.kf")

    assert(result.errors.size == 0)
    for (var limitation in result.limitations) { println(limitation) }
    assert(result.limitations.size == 0)
    var sites = result.sites.sorted((a: MutationSite, b: MutationSite) -> a.offset - b.offset)
    var expected = listOf("+", "<", "-", "*", ">", "/", "+", "<=", "!=", "+", "+", "-", "*", "+", "-", "*")
    assert(sites.size == 16)
    for (var i = 0; i < sites.size; i++) { assert(sites.get(i).original == expected.get(i)) }
    var condition = scanSource("Bool choose(Int a, Int b) { if (a < b) { return true } return false }", "If.kf")
    assert(condition.errors.size == 0)
    assert(condition.limitations.size == 0)
    assert(condition.sites.size == 3)
    println("PASS frontend: conditionals, loops, switch, try, assignments and returns are traversed")
}

unsupportedForms() {
    var result = scanSource("record Point(Int x)", "Unsupported.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 1)
    assert(result.limitations.get(0).contains("RecordDeclarationNode"))
    assert(result.sites.size == 0)
    println("PASS frontend: unsupported AST forms produce explicit limitations")
}

missingSource() {
    var result = scanFile("src/test/fixtures/does-not-exist.kf")

    assert(result.errors.size == 1)
    assert(result.errors.get(0).contains("Cannot read source file"))
    assert(result.sites.size == 0)
    println("PASS frontend: missing source files produce errors")
}

allOperatorDirections() {
    var source = "Bool comparisons(Int a, Int b) { var x = a < b var y = a <= b var z = a > b var w = a >= b var e = a == b var n = a != b return true && false || true } Int math(Int a, Int b) { return (a + b) - (a * b) / b }"

    var result = scanSource(source, "Operators.kf")

    assert(result.errors.size == 0)
    assert(result.limitations.size == 0)
    var sites = result.sites.sorted((a: MutationSite, b: MutationSite) -> a.offset - b.offset)
    var originals = listOf("<", "<=", ">", ">=", "==", "!=", "true", "&&", "false", "||", "true", "+", "-", "*", "/")
    var replacements = listOf("<=", "<", ">=", ">", "!=", "==", "false", "||", "true", "&&", "false", "-", "+", "/", "*")
    assert(sites.size == 15)
    for (var i = 0; i < sites.size; i++) {
        assert(sites.get(i).original == originals.get(i))
        assert(sites.get(i).replacement == replacements.get(i))
        var site = sites.get(i)
        assert(source.substring(site.offset, site.offset + site.length) == originals.get(i))
    }
    println("PASS frontend: all fourteen operator directions use exact lexer tokens")
}

knownTextAndCallOperands() {
    var source = "String label(String prefix) { var a = \"true\" var b = a var c = b + prefix return c + \"!\" } Int one() { return 1 } Int sum() { return one() + one() }"

    var result = scanSource(source, "Text.kf")

    assert(result.errors.size == 0)
    for (var limitation in result.limitations) { println(limitation) }
    assert(result.limitations.size == 0)
    assert(result.sites.size == 1)
    assert(result.sites.get(0).original == "+")
    assert(result.sites.get(0).offset == 139)
    var generic = scanSource("Int size(List<List<Int>> xs) { var letter = '<' var text = \"false + < &&\" return 1 + 2 }", "Generic.kf")
    assert(generic.errors.size == 0)
    assert(generic.limitations.size == 0)
    assert(generic.sites.size == 1)
    assert(generic.sites.get(0).original == "+")
    println("PASS frontend: known text propagation is excluded and call operands retain exact extents")
}

compositeExpressionTraversal() {
    var source = "Int value(Int n) { var a = new Int[1 + n] a[0] = if (n == 0) 1 + 2 else 3 - 1 var b = switch (n) { case 1 -> n * 2 default -> n / 2 } return a[0] + b } class Holder { String text = \"x\" Int numeric = 1 + 2 constructor(String prefix) { var label = prefix + \"!\" } Bool ready() { return false } }"

    var result = scanSource(source, "Composite.kf")

    for (var error in result.errors) { println(error) }
    assert(result.errors.size == 0)
    for (var limitation in result.limitations) { println(limitation) }
    assert(result.limitations.size == 0)
    var sites = result.sites.sorted((a: MutationSite, b: MutationSite) -> a.offset - b.offset)
    var expected = listOf("+", "==", "+", "-", "*", "/", "+", "+", "false")
    assert(sites.size == 9)
    for (var i = 0; i < sites.size; i++) { assert(sites.get(i).original == expected.get(i)) }
    println("PASS frontend: array access, allocation and conditional expressions preserve nested candidates")
}

textScopesAndUnaryOperands() {
    var fields = scanSource("class Labels { String label = \"x\" String show(Int n) { return this.label + n } }", "Fields.kf")
    assert(fields.errors.size == 0)
    assert(fields.limitations.size == 0)
    assert(fields.sites.size == 0)

    var shadow = scanSource("String label(String text) { for (var text in listOf(1)) { var value = text + 1 } return text + 2 }", "Scopes.kf")
    assert(shadow.errors.size == 0)
    assert(shadow.limitations.size == 0)
    assert(shadow.sites.size == 1)
    assert(shadow.sites.get(0).offset == 75)

    var unary = scanSource("Int difference(Int a, Int b) { return -a - -b }", "Unary.kf")
    assert(unary.errors.size == 0)
    assert(unary.limitations.size == 0)
    assert(unary.sites.size == 1)
    assert(unary.sites.get(0).offset == 41)
    println("PASS frontend: declared text fields, local shadowing and unary operands retain exact selection")
}

fieldAndLocalResolution() {
    var numeric = scanSource("class Calc { Int value = 0 Int sum(Int a, Int b) { String value = \"local\" return a + b + this.value } }", "NumericField.kf")

    assert(numeric.errors.size == 0)
    assert(numeric.limitations.size == 0)
    assert(numeric.sites.size == 2, "explicit numeric field must ignore a String local")
    assert(numeric.sites.get(0).original == "+")
    assert(numeric.sites.get(1).original == "+")
    var text = scanSource("class Labels { String value = \"x\" String parameter(Int value) { return this.value + value } String local() { Int value = 1 return this.value + value } Int bare(Int value) { return value + 1 } }", "StringField.kf")
    assert(text.errors.size == 0)
    assert(text.limitations.size == 0)
    assert(text.sites.size == 1, "explicit String field must ignore numeric parameters and locals")
    assert(text.sites.get(0).original == "+")
    println("PASS frontend: this fields resolve independently of lexical parameters and locals")
}

main() {
    fieldAndLocalResolution()
    textScopesAndUnaryOperands()
    compositeExpressionTraversal()
    knownTextAndCallOperands()
    controlFlowTraversal()
    allOperatorDirections()
    binaryTokenLocation()
    memberAndLambdaTraversal()
    fileReading()
    repeatedNestedOperators()
    nonExpressionSymbols()
    unicodeLocations()
    frontendErrors()
    unsupportedForms()
    missingSource()
}
